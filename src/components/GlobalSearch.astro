---
---

<button
  class="op-global-search-open"
  type="button"
  aria-label="Search all sites"
  aria-keyshortcuts="Meta+K Control+K"
  title="Search all sites (⌘K)"
  data-global-search-open
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="m20.3 19-4.7-4.7a7.3 7.3 0 1 0-1.3 1.3l4.7 4.7a.9.9 0 0 0 1.3-1.3ZM5.5 10a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0Z"></path>
  </svg>
  {/* The shortcut, shown beside the icon on a wide bar with a fine pointer
      (components/search.css); the script swaps ⌘ for Ctrl off Apple platforms. */}
  <kbd class="op-global-search-open__hint" aria-hidden="true" data-global-search-hint-key>⌘K</kbd>
</button>

<dialog class="global-search-dialog" aria-labelledby="global-search-title" data-global-search-dialog>
  <div class="global-search-panel">
    <header class="global-search-header">
      <div>
        <p>Portfolio · Notes · Dotfiles</p>
        <h2 id="global-search-title">Search everything</h2>
      </div>
      <button type="button" aria-label="Close search" data-global-search-close>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 4 8 8m0-8-8 8"></path></svg>
      </button>
    </header>

    <label class="global-search-field">
      <span class="global-search-field__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="m20.3 19-4.7-4.7a7.3 7.3 0 1 0-1.3 1.3l4.7 4.7a.9.9 0 0 0 1.3-1.3ZM5.5 10a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0Z"></path></svg>
      </span>
      <span class="sr-only">Search all sites</span>
      <input
        type="search"
        role="combobox"
        aria-label="Search all sites"
        aria-controls="global-search-results"
        aria-expanded="false"
        aria-autocomplete="list"
        placeholder="Search case studies, notes, and Dotfiles…"
        autocomplete="off"
        spellcheck="false"
        data-global-search-input
      />
      <kbd>esc</kbd>
    </label>

    {/* Each scope shows how many of the current query's results it holds
        (Pagefind's per-filter counts), so a reader sees where the matches
        are before narrowing. */}
    <div class="global-search-scopes" role="group" aria-label="Limit search results">
      <button type="button" aria-pressed="true" data-search-product="">All<span data-search-count hidden></span></button>
      <button type="button" aria-pressed="false" data-search-product="Portfolio">Portfolio<span data-search-count hidden></span></button>
      <button type="button" aria-pressed="false" data-search-product="Notes">Notes<span data-search-count hidden></span></button>
      <button type="button" aria-pressed="false" data-search-product="Dotfiles">Dotfiles<span data-search-count hidden></span></button>
    </div>

    <p class="global-search-hint" data-global-search-hint>Search case studies, engineering notes, and Dotfiles documentation.</p>
    <ol class="global-search-results" id="global-search-results" role="listbox" aria-label="Results" data-global-search-results></ol>
  </div>
</dialog>

<script is:inline>
  const initGlobalSearch = () => {
    const open = document.querySelector("[data-global-search-open]");
    const dialog = document.querySelector("[data-global-search-dialog]");
    const close = dialog?.querySelector("[data-global-search-close]");
    const input = dialog?.querySelector("[data-global-search-input]");
    const results = dialog?.querySelector("[data-global-search-results]");
    const hint = dialog?.querySelector("[data-global-search-hint]");
    const scopeButtons = [...(dialog?.querySelectorAll("[data-search-product]") || [])];
    if (!open || !dialog || !input || !results || !hint || open.dataset.bound === "true") return;

    open.dataset.bound = "true";
    let activeProduct = "";
    let requestId = 0;
    let pagefindPromise;
    /* Index of the highlighted result, or -1 for none. The arrow keys move
       it, Enter opens it, and typing resets it. */
    let activeIndex = -1;

    const hintKey = open.querySelector("[data-global-search-hint-key]");
    if (hintKey && !/Mac|iPhone|iPad|iPod/.test(navigator.platform)) hintKey.textContent = "Ctrl K";

    const options = () => [...results.querySelectorAll("[role='option']")];
    const setActive = (index) => {
      const items = options();
      activeIndex = items.length ? Math.max(-1, Math.min(index, items.length - 1)) : -1;
      items.forEach((item, candidate) => {
        item.setAttribute("aria-selected", String(candidate === activeIndex));
        item.toggleAttribute("data-active", candidate === activeIndex);
      });
      const active = items[activeIndex];
      if (active) {
        input.setAttribute("aria-activedescendant", active.id);
        active.scrollIntoView({ block: "nearest" });
      } else {
        input.removeAttribute("aria-activedescendant");
      }
    };

    const escapeHtml = (value) => value.replace(/[&<>'"]/g, (character) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;",
    })[character] || character);

    const safeExcerpt = (value) => value
      .replace(/<(?!\/?mark\b)[^>]*>/gi, "")
      .replace(/<mark(?:\s[^>]*)?>/gi, "<mark>");

    const getPagefind = () => {
      if (!pagefindPromise) {
        const pagefindPath = "/pagefind/pagefind.js";
        pagefindPromise = import(pagefindPath).then(async (pagefind) => {
          await pagefind.init?.();
          /* Loads the filter index once, so every search (filtered or not)
             reports how many results each section holds. */
          await pagefind.filters?.().catch(() => undefined);
          return pagefind;
        });
      }
      return pagefindPromise;
    };

    /* The count beside each scope: how many of this query's results each
       section holds, whatever scope is pressed. Hidden with no query. */
    const setCounts = (counts) => {
      scopeButtons.forEach((button) => {
        const badge = button.querySelector("[data-search-count]");
        if (!badge) return;
        const product = button.dataset.searchProduct;
        const count = counts ? (product ? counts.byProduct[product] ?? 0 : counts.total) : undefined;
        badge.hidden = count === undefined;
        badge.textContent = count === undefined ? "" : String(count);
      });
    };

    const render = async () => {
      const query = input.value.trim();
      const currentRequest = ++requestId;
      if (!query) {
        results.innerHTML = "";
        input.setAttribute("aria-expanded", "false");
        setActive(-1);
        setCounts(undefined);
        hint.textContent = "Search case studies, engineering notes, and Dotfiles documentation.";
        return;
      }

      hint.textContent = "Searching…";
      try {
        const pagefind = await getPagefind();
        const response = await pagefind.search(query, activeProduct ? { filters: { product: activeProduct } } : undefined);
        const matches = await Promise.all(response.results.slice(0, 9).map((result) => result.data()));
        if (currentRequest !== requestId) return;
        const byProduct = Object.keys(response.totalFilters?.product ?? {}).length ? response.totalFilters.product : response.filters?.product ?? {};
        setCounts({ total: response.unfilteredResultCount ?? response.results.length, byProduct });

        hint.textContent = matches.length
          ? `${matches.length} result${matches.length === 1 ? "" : "s"}${activeProduct ? ` in ${activeProduct}` : " across all sites"}`
          : `No results${activeProduct ? ` in ${activeProduct}` : " across all sites"}.`;
        results.innerHTML = matches.map((item, index) => {
          const product = item.meta?.product || "Site";
          const type = item.meta?.type || "Page";
          const title = item.meta?.title || "Untitled";
          const bestSection = item.sub_results?.[0];
          const url = bestSection?.url || item.url;
          const excerpt = safeExcerpt(bestSection?.excerpt || item.excerpt || "Open this page");
          /* "Notes · Note" says nothing twice: the type is shown only when it
             adds to the product name (Portfolio · Case study, Notes · Topic). */
          const kind = type.toLowerCase() === product.toLowerCase().replace(/s$/, "") ? "" : `<i>${escapeHtml(type)}</i>`;
          return `<li role="option" id="global-search-option-${index}" aria-selected="false"><a href="${escapeHtml(url)}" tabindex="-1"><span class="global-search-result-meta"><small data-product="${escapeHtml(product)}">${escapeHtml(product)}</small>${kind}</span><strong>${escapeHtml(title)}</strong><p>${excerpt}</p><b aria-hidden="true">↗</b></a></li>`;
        }).join("");
        input.setAttribute("aria-expanded", String(matches.length > 0));
        setActive(-1);
      } catch (error) {
        if (currentRequest !== requestId) return;
        results.innerHTML = "";
        input.setAttribute("aria-expanded", "false");
        setActive(-1);
        setCounts(undefined);
        const reason = error instanceof Error ? error.message : String(error);
        hint.textContent = `Search is unavailable. ${reason}`;
      }
    };

    const setProduct = (product) => {
      activeProduct = product;
      scopeButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.searchProduct === product)));
      void render();
    };

    const show = () => {
      if (!dialog.open) dialog.showModal();
      input.value = "";
      setProduct("");
      requestAnimationFrame(() => input.focus());
      void getPagefind().catch(() => undefined);
    };
    const hide = () => dialog.open && dialog.close();

    open.addEventListener("click", show);
    open.addEventListener("pointerenter", () => void getPagefind().catch(() => undefined), { once: true });
    open.addEventListener("focus", () => void getPagefind().catch(() => undefined), { once: true });
    close?.addEventListener("click", hide);
    input.addEventListener("input", () => void render());
    /* The keyboard model of a combobox: the arrows walk the results while
       the focus stays in the field, Enter opens the highlighted result (or
       the first one), and Escape closes. A search input consumes Escape to
       clear itself, so with a query typed the first Escape used to empty the
       field and only a second one reached the dialog; the field advertises
       "esc" as the way out, so it closes on the first. */
    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        hide();
      } else if (event.key === "ArrowDown") {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        setActive(activeIndex - 1);
      } else if (event.key === "Home" && options().length && activeIndex >= 0) {
        event.preventDefault();
        setActive(0);
      } else if (event.key === "End" && options().length && activeIndex >= 0) {
        event.preventDefault();
        setActive(options().length - 1);
      } else if (event.key === "Enter") {
        const target = options()[activeIndex] ?? options()[0];
        const link = target?.querySelector("a");
        if (!link) return;
        event.preventDefault();
        location.assign(link.href);
      }
    });
    results.addEventListener("pointermove", (event) => {
      const option = event.target.closest?.("[role='option']");
      if (option) setActive(options().indexOf(option));
    });
    scopeButtons.forEach((button) => button.addEventListener("click", () => setProduct(button.dataset.searchProduct || "")));
    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const box = dialog.getBoundingClientRect();
      if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) hide();
    });
    dialog.addEventListener("close", () => open.focus());
  };

  /* One document-level shortcut for the life of the tab. The client router
     swaps the page (and this dialog) underneath it, so it resolves the
     current trigger at keypress time rather than closing over one. */
  if (!window.omSearchShortcutBound) {
    window.omSearchShortcutBound = true;
    document.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        document.querySelector("[data-global-search-open]")?.click();
      }
    });
  }

  initGlobalSearch();
  document.addEventListener("astro:page-load", initGlobalSearch);
</script>
