<script>
  let controller: AbortController | undefined;

  const initContentInteractions = () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    document.querySelectorAll<HTMLButtonElement>("[data-context-open]").forEach((trigger) => {
      const dialog = document.getElementById(trigger.getAttribute("aria-controls") || "");
      if (!(dialog instanceof HTMLDialogElement) || !dialog.matches("[data-context-dialog]")) return;
      const mobileMount = document.querySelector<HTMLElement>("[data-context-help-mount]");
      const mobile = matchMedia("(width < 40rem)");
      const placeTrigger = () => {
        (mobile.matches && mobileMount ? mobileMount : document.body).append(trigger);
      };
      trigger.setAttribute("data-pagefind-ignore", "");
      dialog.setAttribute("data-pagefind-ignore", "");
      placeTrigger();
      mobile.addEventListener("change", placeTrigger, { signal });
      document.body.append(dialog);
      const close = () => { if (dialog.open) dialog.close(); };
      const closeButton = dialog.querySelector<HTMLButtonElement>("[data-context-close]");
      trigger.addEventListener("click", () => {
        if (dialog.open) return;
        dialog.showModal();
        closeButton?.focus();
      }, { signal });
      closeButton?.addEventListener("click", close, { signal });
      dialog.addEventListener("click", (event) => {
        if (event.target !== dialog) return;
        const box = dialog.getBoundingClientRect();
        if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) close();
      }, { signal });
      dialog.addEventListener("close", () => trigger.focus(), { signal });
    });

    document.querySelectorAll<HTMLElement>(".tabs").forEach((group) => {
      const panels = [...group.querySelectorAll<HTMLElement>(":scope > .tab[data-tab-label]")];
      if (panels.length < 2) return;
      let tablist = group.querySelector<HTMLElement>(":scope > [role='tablist']");
      if (!tablist) {
        tablist = document.createElement("div");
        tablist.setAttribute("role", "tablist");
        tablist.setAttribute("aria-label", group.getAttribute("aria-label") || "Options");
        tablist.setAttribute("data-pagefind-ignore", "");
        const prefix = `content-tabs-${crypto.randomUUID()}`;
        panels.forEach((panel, index) => {
          const button = document.createElement("button");
          button.type = "button";
          button.id = `${prefix}-tab-${index}`;
          button.setAttribute("role", "tab");
          button.textContent = panel.dataset.tabLabel?.trim() || `Option ${index + 1}`;
          panel.id ||= `${prefix}-panel-${index}`;
          button.setAttribute("aria-controls", panel.id);
          panel.setAttribute("role", "tabpanel");
          panel.setAttribute("aria-labelledby", button.id);
          panel.tabIndex = 0;
          tablist?.append(button);
        });
        group.prepend(tablist);
      }
      const buttons = [...tablist.querySelectorAll<HTMLButtonElement>("[role='tab']")];
      const activate = (index: number) => {
        buttons.forEach((button, candidate) => {
          button.setAttribute("aria-selected", String(candidate === index));
          button.tabIndex = candidate === index ? 0 : -1;
        });
        panels.forEach((panel, candidate) => { panel.hidden = candidate !== index; });
      };
      const selected = buttons.findIndex((button) => button.getAttribute("aria-selected") === "true");
      activate(selected >= 0 ? selected : 0);
      buttons.forEach((button, index) => {
        button.addEventListener("click", () => activate(index), { signal });
        button.addEventListener("keydown", (event) => {
          let target: number;
          switch (event.key) {
            case "ArrowRight": target = (index + 1) % buttons.length; break;
            case "ArrowLeft": target = (index - 1 + buttons.length) % buttons.length; break;
            case "Home": target = 0; break;
            case "End": target = buttons.length - 1; break;
            default: return;
          }
          event.preventDefault();
          activate(target);
          buttons[target]?.focus();
        }, { signal });
      });
    });

    /* Diagram exhibits pan sideways below 40rem (primitives.css). A region
       that scrolls must be reachable from the keyboard and announced, so
       each exhibit becomes a named region exactly while it overflows, and
       gives the tab stop back when the column is wide enough again. */
    const diagrams = [...document.querySelectorAll<HTMLElement>(".diagram-exhibit:has(> svg)")];
    const syncDiagramRegions = () => {
      diagrams.forEach((exhibit) => {
        const scrolls = exhibit.scrollWidth > exhibit.clientWidth + 1;
        if (scrolls) {
          const label = exhibit.querySelector(".diagram-exhibit-label, p")?.textContent?.replace(/\s+/g, " ").trim();
          exhibit.tabIndex = 0;
          exhibit.setAttribute("role", "region");
          exhibit.setAttribute("aria-label", label || "Diagram");
        } else {
          exhibit.removeAttribute("tabindex");
          exhibit.removeAttribute("role");
          exhibit.removeAttribute("aria-label");
        }
      });
    };
    if (diagrams.length > 0) {
      let viewer = document.querySelector<HTMLDialogElement>("[data-diagram-viewer]");
      if (!viewer) {
        viewer = document.createElement("dialog");
        viewer.className = "diagram-viewer";
        viewer.setAttribute("data-diagram-viewer", "");
        viewer.setAttribute("data-pagefind-ignore", "");
        viewer.setAttribute("aria-label", "Enlarged diagram");
        viewer.innerHTML = '<header class="diagram-viewer__toolbar"><p data-diagram-title></p><button type="button" data-diagram-out aria-label="Zoom out">−</button><button type="button" data-diagram-in aria-label="Zoom in">+</button><button type="button" data-diagram-fit>Fit</button><button type="button" data-diagram-close>Close</button></header><div class="diagram-viewer__viewport" tabindex="0" role="region" aria-label="Diagram; scroll to explore"></div>';
        document.body.append(viewer);
      }
      const viewport = viewer.querySelector<HTMLElement>(".diagram-viewer__viewport")!;
      const zoomOut = viewer.querySelector<HTMLButtonElement>("[data-diagram-out]")!;
      const zoomIn = viewer.querySelector<HTMLButtonElement>("[data-diagram-in]")!;
      const closeButton = viewer.querySelector<HTMLButtonElement>("[data-diagram-close]")!;
      let opener: HTMLButtonElement | undefined;
      let shown: SVGSVGElement | undefined;
      let readableWidth = 0;
      let width = 0;
      const zoom = (nextWidth: number) => {
        if (!shown) return;
        const viewBox = shown.viewBox.baseVal;
        const fit = Math.min(readableWidth, viewport.clientWidth, viewport.clientHeight * viewBox.width / viewBox.height);
        width = Math.max(fit, Math.min(readableWidth * 2, nextWidth));
        shown.style.width = `${width}px`;
        zoomOut.disabled = width <= fit;
        zoomIn.disabled = width >= readableWidth * 2;
      };
      diagrams.forEach((exhibit) => {
        const svg = exhibit.querySelector<SVGSVGElement>(":scope > svg");
        if (!svg || !svg.viewBox.baseVal.width) return;
        const label = exhibit.querySelector(".diagram-exhibit-label, p")?.textContent?.replace(/\s+/g, " ").trim() || "Diagram";
        const fontSizes = [...svg.querySelectorAll("text")].map((text) => parseFloat(getComputedStyle(text).fontSize)).filter((size) => size > 0);
        const smallestFont = fontSizes.length ? Math.min(...fontSizes) : 12;
        /* Scale the whole drawing: changing text alone can break its layout. */
        exhibit.style.setProperty("--diagram-readable-width", `${svg.viewBox.baseVal.width * Math.max(1, 12 / smallestFont)}px`);
        let trigger = exhibit.nextElementSibling;
        if (!(trigger instanceof HTMLButtonElement) || !trigger.matches("[data-diagram-open]")) {
          trigger = document.createElement("button");
          trigger.setAttribute("type", "button");
          trigger.setAttribute("data-diagram-open", "");
          trigger.setAttribute("data-pagefind-ignore", "");
          trigger.className = "diagram-enlarge";
          trigger.textContent = "Enlarge diagram";
          exhibit.after(trigger);
        }
        const button = trigger as HTMLButtonElement;
        button.setAttribute("aria-label", `Enlarge diagram: ${label}`);
        button.addEventListener("click", () => {
          opener = button;
          shown = svg.cloneNode(true) as SVGSVGElement;
          /* The original stays in the page; its marker and label IDs must
             remain distinct from those in the enlarged drawing. */
          const prefix = `diagram-${crypto.randomUUID()}-`;
          const elements = [shown, ...shown.querySelectorAll("*")];
          const ids = new Map(elements.filter((element) => element.id).map((element) => [element.id, prefix + element.id]));
          elements.forEach((element) => {
            for (const attribute of [...element.attributes]) {
              let value = attribute.value;
              if (attribute.name === "id") value = ids.get(value) || value;
              else if (attribute.name === "aria-labelledby" || attribute.name === "aria-describedby") value = value.split(/\s+/).map((id) => ids.get(id) || id).join(" ");
              else if (attribute.name === "href" || attribute.name === "xlink:href") value = value.startsWith("#") && ids.has(value.slice(1)) ? `#${ids.get(value.slice(1))}` : value;
              else for (const [id, replacement] of ids) value = value.replaceAll(`url(#${id})`, `url(#${replacement})`);
              element.setAttribute(attribute.name, value);
            }
          });
          viewport.replaceChildren(shown);
          viewer!.querySelector("[data-diagram-title]")!.textContent = label;
          readableWidth = svg.viewBox.baseVal.width * Math.max(1, 16 / smallestFont);
          viewer!.showModal();
          zoom(readableWidth);
          viewport.scrollTo(Math.max(0, (readableWidth - viewport.clientWidth) / 2), 0);
          closeButton.focus();
        }, { signal });
      });
      zoomOut.addEventListener("click", () => zoom(width / 1.25), { signal });
      zoomIn.addEventListener("click", () => zoom(width * 1.25), { signal });
      viewer.querySelector("[data-diagram-fit]")!.addEventListener("click", () => zoom(0), { signal });
      closeButton.addEventListener("click", () => viewer!.close(), { signal });
      viewer.addEventListener("close", () => {
        // A queued close event can arrive after another diagram has opened.
        if (viewer!.open) return;
        viewport.replaceChildren();
        shown = undefined;
        opener?.focus();
      }, { signal });
      syncDiagramRegions();
      addEventListener("resize", syncDiagramRegions, { signal });
    }

    /* Printing (print.css). Paper is light and shows everything: the
       document theme goes light for the duration so Expressive Code's palette
       follows the tokens, and every disclosure opens so no detail is left
       folded on the page. Both are restored afterwards. */
    let printTheme: string | undefined;
    let printOpened: HTMLDetailsElement[] = [];
    addEventListener("beforeprint", () => {
      printTheme = document.documentElement.dataset.theme;
      document.documentElement.dataset.theme = "light";
      printOpened = [...document.querySelectorAll<HTMLDetailsElement>("details:not([open])")];
      printOpened.forEach((details) => { details.open = true; });
    }, { signal });
    addEventListener("afterprint", () => {
      if (printTheme) document.documentElement.dataset.theme = printTheme;
      printOpened.forEach((details) => { details.open = false; });
      printOpened = [];
    }, { signal });

    /* Fenced code scrolls sideways instead of wrapping. A frame whose lines
       run past its edge is marked, and prose.css fades the last characters
       until the block is scrolled to its end, so the continuation is visible
       before the scrollbar is noticed. */
    const frames = [...document.querySelectorAll<HTMLElement>(".expressive-code .frame")];
    const syncCodeOverflow = () => {
      frames.forEach((frame, index) => {
        const pre = frame.querySelector("pre");
        if (!pre) return;
        const overflows = pre.scrollWidth > pre.clientWidth + 1;
        frame.toggleAttribute("data-overflows", overflows);
        frame.toggleAttribute("data-scrolled-end", overflows && pre.scrollLeft + pre.clientWidth >= pre.scrollWidth - 1);
        /* Expressive Code makes a scrolling block a focusable region but
           gives it no name, so two on a page were two landmarks called
           nothing. The same three attributes it toggles are set here, in
           one place and named: the block's title, or its place on the page.
           (EC skips a block that already has a tabindex.) */
        if (overflows) {
          const title = frame.querySelector(".title")?.textContent?.replace(/\s+/g, " ").trim();
          pre.setAttribute("tabindex", "0");
          pre.setAttribute("role", "region");
          pre.setAttribute("aria-label", title ? `Code: ${title}` : `Code block ${index + 1}`);
        } else {
          pre.removeAttribute("tabindex");
          pre.removeAttribute("role");
          pre.removeAttribute("aria-label");
        }
      });
    };
    if (frames.length > 0) {
      syncCodeOverflow();
      addEventListener("resize", syncCodeOverflow, { signal });
      frames.forEach((frame) => frame.querySelector("pre")?.addEventListener("scroll", syncCodeOverflow, { passive: true, signal }));
      document.fonts?.ready.then(syncCodeOverflow);
    }

    /* In-page links. The client router answers a same-page hash link itself
       with an instant jump and drops the focus, so base.css's smooth scroll
       (html:focus-within) never sees a TOC click. Handled here instead: the
       target glides into view under the sticky header (instantly under
       reduced motion), the hash is recorded, and focus moves to the target
       so the next Tab continues from it. Links a dialog owns, and clicks
       another handler has already claimed (the reader's study links), are
       left alone. Capture phase: the router's own document listener was
       registered first and would otherwise take the click before this. */
    document.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = (event.target as Element).closest?.("a[href^='#']");
      if (!(link instanceof HTMLAnchorElement) || link.hash.length < 2 || link.closest("dialog")) return;
      const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      if (!target) return;
      event.preventDefault();
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      target.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
      if (location.hash !== link.hash) history.pushState(null, "", link.hash);
      if (!target.hasAttribute("tabindex")) target.tabIndex = -1;
      target.focus({ preventScroll: true });
    }, { capture: true, signal });

    /* Lightbox. An article image whose file is wider than the column it
       renders in (a 1654px screenshot in a 736px exhibit) opens at the size
       the viewport allows, with its caption, in a modal the reader closes
       with Escape, the button or a click anywhere. The image becomes a
       button (role, tabindex, key handling) only while it is worth opening,
       re-judged on resize; images in links, in a deliberately scrolling
       frame, or already shown at full size stay as they are. One dialog per
       page, built here so the markup never has to remember it. */
    const zoomables = [...document.querySelectorAll<HTMLImageElement>("[data-article-body] img, .reader-prose img")]
      .filter((img) => !img.closest("a, .media-frame-scroll, .diagram-exhibit, button"));
    if (zoomables.length > 0) {
      let lightbox = document.querySelector<HTMLDialogElement>("[data-lightbox]");
      if (!lightbox) {
        lightbox = document.createElement("dialog");
        lightbox.className = "lightbox";
        lightbox.setAttribute("data-lightbox", "");
        lightbox.setAttribute("aria-label", "Image, enlarged");
        lightbox.innerHTML = '<figure class="lightbox__figure"><img alt="" width="1" height="1" decoding="async"><figcaption class="lightbox__caption"></figcaption></figure><button type="button" class="lightbox__close" aria-label="Close" data-lightbox-close><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 4 8 8m0-8-8 8"></path></svg></button>';
        document.body.append(lightbox);
      }
      const shown = lightbox.querySelector("img") as HTMLImageElement;
      const caption = lightbox.querySelector<HTMLElement>(".lightbox__caption")!;
      let opener: HTMLImageElement | null = null;
      const open = (img: HTMLImageElement) => {
        opener = img;
        /* The original file, not the rendition the column chose: the dialog
           exists to show the pixels the column could not. */
        shown.src = img.src;
        shown.alt = img.alt;
        shown.width = Number(img.getAttribute("width")) || img.naturalWidth || 1;
        shown.height = Number(img.getAttribute("height")) || img.naturalHeight || 1;
        const text = img.closest("figure")?.querySelector("figcaption")?.textContent?.replace(/\s+/g, " ").trim() ?? "";
        caption.textContent = text;
        caption.hidden = !text;
        if (!lightbox!.open) lightbox!.showModal();
      };
      const close = () => { if (lightbox!.open) lightbox!.close(); };
      const judge = () => {
        /* Worth opening only when both the file and the viewport offer at
           least a fifth more width than the image has in the column: on a
           phone the exhibit already spans the screen, and a dialog that
           shows the same pixels again is a dead end. */
        const gutterSource = document.querySelector(".op-header__inner") ?? document.body;
        const room = document.documentElement.clientWidth - 2 * parseFloat(getComputedStyle(gutterSource).paddingLeft || "0");
        zoomables.forEach((img) => {
          const intrinsic = Number(img.getAttribute("width")) || img.naturalWidth;
          const zoomable = img.clientWidth > 0 && intrinsic > img.clientWidth * 1.2 && room > img.clientWidth * 1.2;
          img.toggleAttribute("data-zoomable", zoomable);
          if (zoomable) {
            img.setAttribute("role", "button");
            img.tabIndex = 0;
            img.setAttribute("aria-label", `${img.alt || "Image"} (open larger)`);
          } else {
            img.removeAttribute("role");
            img.removeAttribute("tabindex");
            img.removeAttribute("aria-label");
          }
        });
      };
      judge();
      addEventListener("resize", judge, { signal });
      zoomables.forEach((img) => {
        img.addEventListener("click", () => { if (img.hasAttribute("data-zoomable")) open(img); }, { signal });
        img.addEventListener("keydown", (event) => {
          if (!img.hasAttribute("data-zoomable") || (event.key !== "Enter" && event.key !== " ")) return;
          event.preventDefault();
          open(img);
        }, { signal });
      });
      lightbox.addEventListener("click", close, { signal });
      lightbox.querySelector("[data-lightbox-close]")?.addEventListener("click", close, { signal });
      lightbox.addEventListener("close", () => { opener?.focus(); opener = null; }, { signal });
    }

    const filter = document.querySelector<HTMLElement>("[data-shortcut-filter]");
    const input = filter?.querySelector<HTMLInputElement>("[data-shortcut-query]");
    const sections = [...document.querySelectorAll<HTMLElement>("[data-shortcut-section]")];
    if (!filter || !input || sections.length === 0) return;
    const clear = filter.querySelector<HTMLButtonElement>("[data-shortcut-clear]");
    const buttons = [...filter.querySelectorAll<HTMLButtonElement>("[data-shortcut-scope]")];
    const empty = document.querySelector<HTMLElement>("[data-shortcut-empty]");
    const status = filter.querySelector<HTMLElement>("[data-shortcut-status]");
    const references = sections.map((section) => ({
      section,
      rows: [...section.querySelectorAll<HTMLTableRowElement>("tbody tr")].map((row) => ({
        row, text: row.textContent?.toLowerCase() || "",
      })),
    }));
    const total = references.reduce((count, reference) => count + reference.rows.length, 0);
    let scope = buttons.find((button) => button.getAttribute("aria-pressed") === "true")?.dataset.shortcutScope || "all";
    const updateFilter = () => {
      const terms = input.value.toLowerCase().trim().split(/[\s+]+/).filter(Boolean);
      let count = 0;
      references.forEach(({ section, rows }) => {
        const scopeMatches = scope === "all" || section.dataset.shortcutSection === scope;
        let sectionCount = 0;
        rows.forEach(({ row, text }) => {
          const matches = scopeMatches && terms.every((term) => text.includes(term));
          row.hidden = !matches;
          if (matches) sectionCount += 1;
        });
        section.hidden = sectionCount === 0;
        count += sectionCount;
      });
      buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.shortcutScope === scope)));
      if (clear) clear.hidden = !input.value;
      if (empty) empty.hidden = count > 0;
      if (status) status.textContent = `Showing ${count} of ${total} shortcuts`;
    };
    input.addEventListener("input", updateFilter, { signal });
    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && input.value) {
        event.preventDefault();
        input.value = "";
        updateFilter();
      }
    }, { signal });
    clear?.addEventListener("click", () => {
      input.value = "";
      input.focus();
      updateFilter();
    }, { signal });
    buttons.forEach((button) => button.addEventListener("click", () => {
      scope = button.dataset.shortcutScope || "all";
      updateFilter();
    }, { signal }));
    updateFilter();
  };

  initContentInteractions();
  document.addEventListener("astro:page-load", initContentInteractions);
  document.addEventListener("astro:before-swap", () => controller?.abort());
  document.addEventListener("oponomarov:content-updated", initContentInteractions);
</script>
