---
interface ArticleLink {
  readonly href: string;
  readonly title: string;
  readonly label?: string;
}

interface Props {
  readonly title: string;
  /** The dek as plain text; escaped on output. */
  readonly description?: string;
  /** The dek already rendered from inline Markdown (src/lib/inline-markdown.ts); wins over `description`. */
  readonly descriptionHtml?: string;
  readonly eyebrow?: string;
  readonly backLink?: ArticleLink;
  readonly publishedTime?: Date;
  readonly readingMinutes?: number;
  readonly previous?: ArticleLink;
  readonly next?: ArticleLink;
  readonly adjacentLabel?: string;
}

const {
  title, description, descriptionHtml, eyebrow, backLink, publishedTime, readingMinutes,
  previous, next, adjacentLabel = "Adjacent articles",
} = Astro.props;
const dateLabel = publishedTime && new Intl.DateTimeFormat("en-GB", {
  day: "2-digit", month: "long", year: "numeric", timeZone: "UTC",
}).format(publishedTime);
---

<main id="main-content" class="article content-grid" tabindex="-1">
  <header class="article-header">
    {backLink && <a class="back-link" href={backLink.href} data-pagefind-ignore>{backLink.title}</a>}
    {/* The kicker and the metadata line are page furniture, not article
        text: indexed, they led every search excerpt with "Case study 10."
        or "23 December 2024 · 8 min read" ahead of the words that matched. */}
    {eyebrow && <p class="eyebrow" data-pagefind-ignore>{eyebrow}</p>}
    {/* Indexed, and weighted: a word in a title should outrank the same
        word in a paragraph, and a title word absent from the body must still
        find the page. SiteLayout supplies the clean title for the result. */}
    <h1 data-pagefind-weight="8">{title}</h1>
    {descriptionHtml ? <p class="article-dek prose prose--lede" set:html={descriptionHtml} /> : description && <p class="article-dek prose prose--lede">{description}</p>}
    {(publishedTime || readingMinutes !== undefined) && (
      <p class="article-meta" data-pagefind-ignore>
        {publishedTime && <time datetime={publishedTime.toISOString()}>{dateLabel}</time>}
        {publishedTime && readingMinutes !== undefined && <span aria-hidden="true">·</span>}
        {readingMinutes !== undefined && <span>{readingMinutes} min read</span>}
      </p>
    )}
    <slot name="meta" />
    <slot name="proof" />
    <slot name="topics" />
    <slot name="actions" />
  </header>
  {/* The TOC follows the header in DOM order: a disclosure between title and
      body below 80rem, a sticky rail beside both from 80rem (layout.css). */}
  <slot name="toc" />
  <div data-context-help-mount data-pagefind-ignore></div>
  <article class="prose content-grid full-bleed" data-article-body>
    <slot />
  </article>
  {(previous || next) && (
    <nav class="adjacent-nav" aria-label={adjacentLabel} data-pagefind-ignore>
      {previous && (
        <a href={previous.href} rel="prev" data-study-direction="previous">
          <span class="adjacent-nav__label">{previous.label ?? "← Previous"}</span>
          <strong class="adjacent-nav__title">{previous.title}</strong>
        </a>
      )}
      {next && (
        <a class="adjacent-nav__next" href={next.href} rel="next" data-study-direction="next">
          <span class="adjacent-nav__label">{next.label ?? "Next →"}</span>
          <strong class="adjacent-nav__title">{next.title}</strong>
        </a>
      )}
    </nav>
  )}
  <slot name="footer" />
  <slot name="comments" />
</main>
