---
import GlobalSearch from "./GlobalSearch.astro";

interface Props {
  activeApp: "portfolio" | "blog" | "dotfiles" | "contact";
  showProgress?: boolean;
}

const { activeApp, showProgress = false } = Astro.props;

const apps = [
  { id: "portfolio", label: "Portfolio", href: "/" },
  { id: "blog", label: "Notes", href: "/blog/" },
  { id: "dotfiles", label: "Dotfiles", href: "/dotfiles/" },
];
---

<header class="op-header" data-site-header>
  {showProgress && <div class="op-reading-progress" aria-hidden="true"><span data-reading-progress></span></div>}
  <div class="op-header__inner">
    <a class="op-brand" href="/">
      <span class="op-brand__full">~/oleksandr-ponomarov</span>
      <span class="op-brand__short" aria-hidden="true">~/op</span>
    </a>

    <nav class="op-app-nav" aria-label="Site sections">
      {apps.map((app) => (
        <a
          href={app.href}
          data-app-link={app.id}
          class:list={{ "is-active": app.id === activeApp }}
          aria-current={app.id === activeApp ? "page" : undefined}
        >
          {app.label}
        </a>
      ))}
    </nav>
    <div class="op-header__tools">
      <GlobalSearch />
      <button class="op-theme-toggle" type="button" aria-label="Switch to light theme" data-op-theme-toggle>
        <span aria-hidden="true" data-theme-label>light</span>
        {/* Below 48rem the written label collapses and this half-disc stands
            in for it (components/shell.css). Drawn as an SVG rather than the
            ◐ glyph: neither site font carries that code point, and the
            fallback rendered it as a four-pixel dot. */}
        <svg class="op-theme-toggle__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M8 2.5a5.5 5.5 0 0 0 0 11Z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  /* Bundled once per site load. Every navigation (a full load, or the client
     router swapping the document) re-runs initShell against the fresh DOM and
     the previous run's listeners are dropped through an AbortController, so
     no scroll handler outlives the elements it drove. */
  let controller: AbortController | undefined;

  const readSavedTheme = () => {
    const saved = localStorage.getItem("om-theme");
    if (saved === "light" || saved === "dark") return saved;
    return matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
  };
  const getTheme = () => document.documentElement.dataset.theme === "light" ? "light" : "dark";

  const persistTheme = (theme: "dark" | "light") => {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem("om-theme", theme);
    window.dispatchEvent(new CustomEvent("om-theme-change", { detail: theme }));
  };

  const updateControls = () => {
    const theme = getTheme();
    document.querySelectorAll<HTMLElement>("[data-theme-label]").forEach((label) => {
      label.textContent = theme === "dark" ? "light" : "dark";
    });
    document.querySelectorAll<HTMLButtonElement>("[data-op-theme-toggle]").forEach((button) => {
      button.setAttribute("aria-label", `Switch to ${theme === "dark" ? "light" : "dark"} theme`);
    });
  };

  const initShell = () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    updateControls();
    document.querySelectorAll<HTMLButtonElement>("[data-op-theme-toggle]").forEach((button) => {
      button.addEventListener("click", () => {
        persistTheme(getTheme() === "dark" ? "light" : "dark");
        updateControls();
      }, { signal });
    });

    const progress = document.querySelector<HTMLElement>("[data-reading-progress]");
    if (progress) {
      const update = () => {
        const available = document.documentElement.scrollHeight - innerHeight;
        const ratio = available > 0 ? Math.min(1, scrollY / available) : 0;
        progress.style.transform = `scaleX(${ratio})`;
      };
      addEventListener("scroll", update, { passive: true, signal });
      update();
    }

    const toTop = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
    if (toTop) {
      let scheduled = false;
      const update = () => {
        toTop.dataset.visible = String(scrollY > 640);
        scheduled = false;
      };
      const schedule = () => {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(update);
      };
      addEventListener("scroll", schedule, { passive: true, signal });
      addEventListener("resize", schedule, { signal });
      toTop.addEventListener("click", () => {
        scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      }, { signal });
      update();
    }
  };

  initShell();
  document.addEventListener("astro:page-load", initShell);
  document.addEventListener("astro:before-swap", () => controller?.abort());
  /* The swap copies the incoming document's root attributes over the current
     ones, which drops the theme the inline head script set on first load; put
     it back before the new page paints, so a reader on the saved theme never
     sees the other one flash through. */
  document.addEventListener("astro:after-swap", () => {
    document.documentElement.dataset.theme = readSavedTheme();
  });
</script>
