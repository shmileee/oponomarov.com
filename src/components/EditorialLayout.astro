---
import "../styles/global.css";
import "../styles/experience.css";
import BackToTop from "./BackToTop.astro";
import CodeFrames from "./CodeFrames.astro";
import SiteFavicons from "./SiteFavicons.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import { documentTitle as formatDocumentTitle } from "../lib/site-metadata";

interface Props {
  site: "portfolio" | "blog";
  title: string;
  description: string;
  canonicalOrigin: string;
  article?: boolean;
  publishedTime?: Date;
  tags?: string[];
  robots?: string;
  searchType?: string;
}

const {
  site,
  title,
  description,
  canonicalOrigin,
  article = false,
  publishedTime,
  tags = [],
  robots,
  searchType = article ? (site === "portfolio" ? "Case study" : "Note") : "Overview",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, canonicalOrigin || "https://oponomarov.com");
const isPortfolio = site === "portfolio";
const siteRoot = isPortfolio ? "/" : "/blog/";
const documentTitle = formatDocumentTitle(site, Astro.url.pathname === siteRoot ? undefined : title);
// Public assets are not fingerprinted by Astro. Keep one shared revision here so
// a deploy cannot leave the reader or editorial skin behind in a browser cache.
const publicAssetRevision = "20260901-5";
const publicAsset = (path: string) => `${path}?v=${publicAssetRevision}`;
const stylesheet = publicAsset(isPortfolio ? "/assets/css/site.css" : "/blog-assets/css/main.css");
const siteScript = publicAsset(isPortfolio ? "/assets/js/site.js" : "/blog-assets/js/site.js");
const searchProduct = isPortfolio ? "Portfolio" : "Notes";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="Oleksandr Ponomarov" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      (() => {
        document.documentElement.dataset.theme = localStorage.getItem("om-theme") || "dark";
      })();
    </script>
    <title>{documentTitle}</title>
    <meta name="description" content={description} data-pagefind-meta="description[content]" />
    <meta content={searchProduct} data-pagefind-meta="product[content]" data-pagefind-filter="product[content]" />
    <meta content={searchType} data-pagefind-meta="type[content]" />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <SiteFavicons />
    {!isPortfolio && <link rel="alternate" type="application/rss+xml" title="Engineering notes" href="/blog/feed.xml" />}
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    {isPortfolio && <meta property="og:image" content="https://oponomarov.com/assets/og-image.png" />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} data-pagefind-filter="tag[content]" />)}
    <meta name="twitter:card" content={isPortfolio ? "summary_large_image" : "summary"} />
    {!isPortfolio && <meta name="twitter:creator" content="@sqrt16bit" />}
    <link rel="stylesheet" href={stylesheet} />
    {!isPortfolio && <link rel="stylesheet" href={publicAsset("/blog-assets/css/syntax.css")} />}
    <slot name="head" />
  </head>
  <body data-app={site}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader activeApp={site} showProgress={article || isPortfolio} />

    <slot />

    <BackToTop />
    <SiteFooter activeApp={site} />
    <CodeFrames />
    <script is:inline src={siteScript} type={isPortfolio ? "module" : undefined} defer={!isPortfolio}></script>
  </body>
</html>
