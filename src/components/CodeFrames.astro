<script>
  const languageName = (pre: HTMLPreElement) => {
    const value = pre.dataset.language
      || [...pre.classList].find((name) => name.startsWith("language-"))?.slice("language-".length)
      || "text";
    return value === "sh" ? "shell" : value;
  };

  const copyText = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.setAttribute("readonly", "");
      textarea.style.position = "fixed";
      textarea.style.opacity = "0";
      document.body.append(textarea);
      textarea.select();
      const legacyCopy = Reflect.get(document, "execCommand");
      const copied = typeof legacyCopy === "function"
        && Reflect.apply(legacyCopy, document, ["copy"]);
      textarea.remove();
      return copied;
    }
  };

  const ensureCopyIcon = (button: HTMLButtonElement) => {
    if (button.querySelector(":scope > .op-code-frame__copy-icon")) return;
    button.insertAdjacentHTML(
      "beforeend",
      `<svg class="op-code-frame__copy-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect width="14" height="14" x="8" y="8" rx="2"></rect>
        <path d="M16 8V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4"></path>
      </svg>`,
    );
  };

  const enhanceCodeFrames = (root: ParentNode = document) => {
    root.querySelectorAll<HTMLElement>(".code-exhibit, .expressive-code").forEach((frame) => {
      frame.classList.add("op-code-frame");
      frame.dataset.unifiedCodeFrame = "true";

      if (frame.classList.contains("expressive-code")) {
        const pre = frame.querySelector<HTMLPreElement>("pre");
        const header = frame.querySelector<HTMLElement>("figcaption.header");
        let title = header?.querySelector<HTMLElement>(".title");
        const copy = frame.querySelector<HTMLElement>(".copy");
        const copyButton = copy?.querySelector<HTMLButtonElement>("button");
        const copyStatus = copy?.querySelector<HTMLElement>("[aria-live]");
        copyStatus?.classList.add("op-code-frame__copy-status");
        if (header && !title) {
          title = document.createElement("span");
          title.className = "title";
          header.prepend(title);
        }
        if (header && !header.querySelector(":scope > .op-code-frame__dots")) {
          const dots = document.createElement("span");
          dots.className = "op-code-frame__dots";
          dots.setAttribute("aria-hidden", "true");
          dots.innerHTML = "<i></i><i></i><i></i>";
          header.prepend(dots);
        }
        if (pre && title && !title.textContent?.trim()) title.textContent = languageName(pre);
        if (title?.textContent?.trim()) title.title = title.textContent.trim();
        if (header && copy && !header.contains(copy)) {
          copy.classList.add("op-code-frame__copy-control");
          header.append(copy);
        }
        if (pre && copyButton) {
          copyButton.classList.add("op-code-frame__copy-button");
          copyButton.setAttribute("aria-label", "Copy code to clipboard");
          ensureCopyIcon(copyButton);
          if (copyButton.dataset.unifiedCopyBound !== "true") {
            copyButton.dataset.unifiedCopyBound = "true";
            copyButton.addEventListener("click", async (event) => {
              event.preventDefault();
              event.stopImmediatePropagation();
              const code = copyButton.dataset.code?.replaceAll("\u007f", "\n") || pre.textContent || "";
              const copied = await copyText(code);
              const feedback = copied ? "Copied to clipboard." : "Unable to copy; select the code manually.";
              copyButton.dataset.copyState = copied ? "copied" : "failed";
              copyButton.setAttribute("aria-label", feedback);
              copyButton.title = feedback;
              if (copyStatus) copyStatus.textContent = feedback;
              window.setTimeout(() => {
                delete copyButton.dataset.copyState;
                copyButton.setAttribute("aria-label", "Copy code to clipboard");
                copyButton.title = "Copy to clipboard";
                if (copyStatus) copyStatus.textContent = "";
              }, 1800);
            });
          }
        }
      }
    });

    root.querySelectorAll<HTMLPreElement>(".prose pre, .sl-markdown-content pre").forEach((pre) => {
      if (pre.dataset.codeEnhanced === "true" || pre.closest("[data-unified-code-frame]")) return;

      const frame = document.createElement("div");
      frame.className = "op-code-frame op-code-frame--generated";
      frame.dataset.unifiedCodeFrame = "true";

      const toolbar = document.createElement("div");
      toolbar.className = "op-code-frame__toolbar";

      const dots = document.createElement("span");
      dots.className = "op-code-frame__dots";
      dots.setAttribute("aria-hidden", "true");
      dots.innerHTML = "<i></i><i></i><i></i>";

      const label = document.createElement("span");
      label.className = "op-code-frame__label";
      label.textContent = languageName(pre);

      const copy = document.createElement("button");
      copy.className = "op-code-frame__copy-button";
      copy.type = "button";
      copy.setAttribute("aria-label", "Copy code to clipboard");
      copy.title = "Copy to clipboard";
      ensureCopyIcon(copy);

      const copyStatus = document.createElement("span");
      copyStatus.className = "op-code-frame__copy-status";
      copyStatus.setAttribute("aria-live", "polite");
      copy.addEventListener("click", async () => {
        const copied = await copyText(pre.textContent || "");
        const feedback = copied ? "Copied to clipboard." : "Unable to copy; select the code manually.";
        copy.dataset.copyState = copied ? "copied" : "failed";
        copy.setAttribute("aria-label", feedback);
        copy.title = feedback;
        copyStatus.textContent = feedback;
        window.setTimeout(() => {
          delete copy.dataset.copyState;
          copy.setAttribute("aria-label", "Copy code to clipboard");
          copy.title = "Copy to clipboard";
          copyStatus.textContent = "";
        }, 1800);
      });

      toolbar.append(dots, label, copyStatus, copy);
      pre.before(frame);
      frame.append(toolbar, pre);
      pre.dataset.codeEnhanced = "true";
    });
  };

  const handleContentUpdated = (event: Event) => {
    const root = event instanceof CustomEvent && event.detail?.root instanceof Element
      ? event.detail.root
      : document;
    enhanceCodeFrames(root);
  };

  enhanceCodeFrames();
  document.addEventListener("astro:page-load", () => enhanceCodeFrames());
  document.addEventListener("oponomarov:content-updated", handleContentUpdated);
</script>
