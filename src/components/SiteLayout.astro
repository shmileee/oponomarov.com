---
import "../styles/index.css";
import BackToTop from "./BackToTop.astro";
import ContentInteractions from "./ContentInteractions.astro";
import SiteFavicons from "./SiteFavicons.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import { documentTitle as formatDocumentTitle, ownerName, type SiteSection } from "../lib/site-metadata";

interface Props {
  readonly activeApp: SiteSection;
  readonly title?: string;
  readonly description: string;
  readonly canonicalOrigin?: string;
  readonly canonicalPath?: string;
  readonly article?: boolean;
  readonly publishedTime?: Date;
  readonly tags?: readonly string[];
  readonly robots?: string;
  readonly searchType?: string;
  readonly searchProduct?: string;
  readonly indexable?: boolean;
  readonly showProgress?: boolean;
  readonly rssHref?: string;
  readonly ogImage?: string;
}

const {
  activeApp,
  title,
  description,
  canonicalOrigin = "https://oponomarov.com",
  canonicalPath = Astro.url.pathname,
  article = false,
  publishedTime,
  tags = [],
  robots,
  indexable = true,
  showProgress = article || activeApp === "portfolio",
  rssHref = activeApp === "blog" ? "/blog/feed.xml" : undefined,
  ogImage = activeApp === "portfolio" ? "/assets/og-image.png" : undefined,
} = Astro.props;
const roots = { portfolio: "/", blog: "/blog/", dotfiles: "/dotfiles/", contact: "/contact/" } as const;
const products = { portfolio: "Portfolio", blog: "Notes", dotfiles: "Dotfiles", contact: "Site" } as const;
const articleTypes = { portfolio: "Case study", blog: "Note", dotfiles: "Documentation", contact: "Contact" } as const;
const searchProduct = Astro.props.searchProduct ?? products[activeApp];
const searchType = Astro.props.searchType ?? (article || activeApp === "dotfiles" || activeApp === "contact" ? articleTypes[activeApp] : "Overview");
const documentTitle = formatDocumentTitle(activeApp, Astro.url.pathname === roots[activeApp] ? undefined : title);
const plainTitle = title ?? products[activeApp];
const canonical = new URL(canonicalPath, canonicalOrigin);
const image = ogImage ? new URL(ogImage, canonicalOrigin) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <style is:inline>@layer reset, tokens, base, expressive-code, layout, components, prose, primitives, utilities;</style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content={ownerName} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
const saved = localStorage.getItem("om-theme");
const preferred = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
document.documentElement.dataset.theme = saved || preferred;
    </script>
    <title>{documentTitle}</title>
    <meta name="description" content={description} data-pagefind-meta="description[content]" />
    <meta content={searchProduct} data-pagefind-meta="product[content]" data-pagefind-filter="product[content]" />
    <meta content={searchType} data-pagefind-meta="type[content]" />
    {/* The result title is the page's own title, not the first h1 Pagefind
        happens to find (a case-study h1 can carry a code capsule). */}
    <meta content={plainTitle} data-pagefind-meta="title[content]" />
    {robots && <meta name="robots" content={robots} />}
    <link rel="preload" href="/assets/fonts/public-sans-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/assets/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="canonical" href={canonical} />
    <SiteFavicons />
    {rssHref && <link rel="alternate" type="application/rss+xml" title="Engineering notes" href={rssHref} />}
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} data-pagefind-filter="tag[content]" />)}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {activeApp === "blog" && <meta name="twitter:creator" content="@sqrt16bit" />}
    <slot name="head" />
  </head>
  <body data-app={activeApp} data-pagefind-ignore={indexable ? undefined : "all"}>
    <a class="skip-link" href="#main-content" data-pagefind-ignore>Skip to content</a>
    <SiteHeader activeApp={activeApp} showProgress={showProgress} />
    <div class="page" data-pagefind-body={indexable || undefined}>
      <slot />
    </div>
    <SiteFooter activeApp={activeApp} />
    <BackToTop />
    <ContentInteractions />
  </body>
</html>
