---
import type { MarkdownHeading } from "astro";

interface Props {
  readonly headings: readonly MarkdownHeading[];
  readonly label?: string;
}

const { headings, label = "On this page" } = Astro.props;
const entries = headings.filter(({ depth, slug, text }) => (depth === 2 || depth === 3) && slug && text.trim());
const count = `${entries.length} ${entries.length === 1 ? "section" : "sections"}`;
---

{/* One markup serves both renderings (components/navigation.css): a bordered
    disclosure card below 80rem, a sticky rail beside the article above it,
    where layout.css places it and the count and marker are hidden.

    Who gets one: every route rendered through ArticleShell — docs pages, blog
    posts and case studies — passes its own headings here, so presence and
    behaviour are a property of the shell rather than of each route. The one
    deliberate exemption is /dotfiles/, a hub landing page that is not an
    article: it indexes the docs set rather than being read top to bottom, has
    no reading progress and no adjacent navigation, and so renders no shell and
    no rail. .omo/qa/toc-audit.mjs encodes that exemption as an expectation. */}
{entries.length > 0 && (
  <aside class="toc" data-pagefind-ignore>
    <details class="toc__details" data-page-toc open>
      <summary class="toc__summary">
        <span class="toc__label"><strong>{label}</strong><small class="toc__count">{count}</small></span>
        <span class="toc__marker" aria-hidden="true"></span>
      </summary>
      <nav class="toc__nav" aria-label={label}>
        <ol class="toc__list">
          {entries.map((heading) => (
            <li class:list={{ "toc__item--nested": heading.depth === 3 }}>
              <a href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
    {/* The disclosure's state is decided before the first paint. Rendered
        open and closed by the module script after load, the list stood
        335px tall for one frame on every phone and tablet and then folded,
        moving the whole article up (CLS 0.02–0.11 on every article route).
        This runs as the parser reaches it, ahead of layout, and again after
        every client-side navigation (data-astro-rerun), so the shape the
        reader sees first is the shape that stays. The module script below
        keeps owning the summary's tab stop and the breakpoint changes. */}
    <script is:inline data-astro-rerun>
      (() => {
        const details = document.currentScript?.previousElementSibling;
        if (details instanceof HTMLDetailsElement) details.open = matchMedia("(width >= 80rem)").matches;
      })();
    </script>
  </aside>
)}

<script>
  let controller: AbortController | undefined;
  const initToc = () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;
    const desktop = matchMedia("(width >= 80rem)");
    document.querySelectorAll<HTMLDetailsElement>("[data-page-toc]").forEach((details) => {
      const summary = details.querySelector("summary");
      const syncDisclosure = () => {
        details.open = desktop.matches;
        /* In the rail the label is a caption, not a control: it must not be
           able to collapse the only copy of the navigation, and it is not a
           tab stop. Below the rail it is the disclosure's button again. */
        if (summary) summary.tabIndex = desktop.matches ? -1 : 0;
      };
      syncDisclosure();
      desktop.addEventListener("change", syncDisclosure, { signal });
      /* Enter and Space on a <summary> both dispatch click, so one listener
         covers pointer and keyboard. */
      summary?.addEventListener("click", (event) => {
        if (desktop.matches) event.preventDefault();
      }, { signal });
      const links = [...details.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
      const targets = links.flatMap((link) => {
        const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        return heading ? [{ link, heading }] : [];
      });
      /* The rail is bounded to the viewport and scrolls inside itself, so on a
         long page the entry in view can sit outside the visible band. Bring it
         back only when the active entry changes, so a reader who has scrolled
         the rail by hand is not fought on every frame. */
      const nav = details.querySelector<HTMLElement>(".toc__nav");
      /* The list hides its scrollbar (navigation.css); these marks drive the
         edge fades that say where more entries are. */
      const syncEdges = () => {
        if (!nav) return;
        const overflows = nav.scrollHeight > nav.clientHeight + 1;
        nav.toggleAttribute("data-overflows", overflows);
        nav.toggleAttribute("data-at-start", overflows && nav.scrollTop <= 1);
        nav.toggleAttribute("data-at-end", overflows && nav.scrollTop + nav.clientHeight >= nav.scrollHeight - 1);
      };
      nav?.addEventListener("scroll", syncEdges, { passive: true, signal });
      addEventListener("resize", syncEdges, { signal });
      details.addEventListener("toggle", syncEdges, { signal });
      document.fonts?.ready.then(() => { if (!signal.aborted) syncEdges(); });
      syncEdges();
      let revealed: HTMLAnchorElement | undefined;
      const reveal = (link: HTMLAnchorElement) => {
        if (!nav || nav.scrollHeight <= nav.clientHeight + 1) return;
        const top = link.offsetTop - nav.offsetTop;
        const margin = link.offsetHeight;
        const atLeast = top + link.offsetHeight + margin - nav.clientHeight;
        const atMost = Math.max(top - margin, 0);
        nav.scrollTop = Math.min(Math.max(nav.scrollTop, atLeast), atMost);
      };
      const updateActive = () => {
        const headerBottom = document.querySelector("[data-site-header]")?.getBoundingClientRect().bottom ?? 0;
        const atEnd = scrollY + innerHeight >= document.documentElement.scrollHeight - 2;
        const active = atEnd ? targets.at(-1) : targets.findLast(({ heading }) => heading.getBoundingClientRect().top <= headerBottom) ?? targets[0];
        targets.forEach(({ link }) => {
          if (link === active?.link) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
        if (active?.link && active.link !== revealed) reveal(active.link);
        revealed = active?.link;
      };
      let scheduled = false;
      addEventListener("scroll", () => {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(() => {
          scheduled = false;
          if (!signal.aborted) updateActive();
        });
      }, { passive: true, signal });
      updateActive();
    });
  };
  initToc();
  document.addEventListener("astro:page-load", initToc);
  document.addEventListener("astro:before-swap", () => controller?.abort());
</script>
