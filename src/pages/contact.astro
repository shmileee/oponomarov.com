---
import SiteLayout from "../components/SiteLayout.astro";
---

<SiteLayout
  activeApp="contact"
  title="Contact"
  description="Contact Oleksandr Ponomarov by email, LinkedIn, or GitHub."
  searchType="Contact"
>
  <main id="main-content" class="content-grid" tabindex="-1">
    <div class="contact-page wide">
      <section class="contact-hero section-shell hero" aria-labelledby="contact-title">
        <h1 id="contact-title">Let’s talk.<span class="hero-cursor" aria-hidden="true"></span></h1>
        <p class="prose prose--lede">For roles, collaborations, technical conversations, or questions about something I’ve published, choose the channel that fits.</p>
      </section>

      <section class="contact-methods section-shell" aria-label="Ways to get in touch">
        <a class="contact-method" id="email" href="mailto:ponomarov.aleksandr@gmail.com">
          <span class="contact-method__number">01 · direct</span>
          <h2>Email me</h2>
          <p class="prose">Best when your message needs context, an introduction, or a concrete next step.</p>
          <span class="contact-method__action">ponomarov.aleksandr@gmail.com <span aria-hidden="true">→</span></span>
        </a>

        <a class="contact-method" id="linkedin" href="https://www.linkedin.com/in/aleksandr-ponomarov" rel="me">
          <span class="contact-method__number">02 · professional</span>
          <h2>Connect on LinkedIn</h2>
          <p class="prose">Useful for professional introductions, roles, collaborations, and staying in touch.</p>
          <span class="contact-method__action">Open LinkedIn <span aria-hidden="true">↗</span></span>
        </a>

        <a class="contact-method" id="github" href="https://github.com/shmileee" rel="me">
          <span class="contact-method__number">03 · public work</span>
          <h2>Find me on GitHub</h2>
          <p class="prose">Use this for repositories, implementation details, and the public work behind these sites.</p>
          <span class="contact-method__action">github.com/shmileee <span aria-hidden="true">↗</span></span>
        </a>
      </section>

      <section class="contact-note section">
        <div class="section-shell">
          <p class="section-eyebrow">A useful first message</p>
          <p class="prose prose--lede">A short note about why you’re reaching out, any relevant link, and the next step you have in mind is plenty.</p>
        </div>
      </section>
    </div>
  </main>
</SiteLayout>
