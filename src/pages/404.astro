---
import SiteLayout from "../components/SiteLayout.astro";
---

<SiteLayout
  activeApp="portfolio"
  canonicalOrigin="https://oponomarov.com"
  title="Page not found"
  description="This page does not exist. Browse the case-study index or head back to the homepage."
  robots="noindex,follow"
  indexable={false}
  ogImage="https://oponomarov.com/assets/og-image.png"
>
  <main id="main-content" class="content-grid" tabindex="-1">
    <section class="hero section-shell">
      <p class="eyebrow">404 — not found</p>
      <h1>This page doesn't exist<span class="hero-cursor" aria-hidden="true"></span></h1>
      <div class="hero-copy prose prose--lede"><p>The address may be mistyped, or the page may have moved. The work itself is still one link away.</p></div>
      <div class="hero-actions">
        <a class="primary-link" href="/#index">Browse case studies →</a>
        <a class="secondary-link" href="/">Back to the homepage</a>
      </div>
    </section>
  </main>
</SiteLayout>
