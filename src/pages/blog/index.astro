---
import { getCollection } from "astro:content";
import SiteLayout from "../../components/SiteLayout.astro";
import { formatDate, slugForPost, sortPosts } from "../../lib/posts";
import { topicTag } from "../../lib/topic-labels";
import { pageDescriptions } from "../../lib/site-metadata";

const posts = sortPosts(await getCollection("posts"));
const years = Map.groupBy(posts, (post) => String(post.data.date.getFullYear()));
const categoryCounts = new Map<string, number>();
posts.forEach((post) => post.data.categories.forEach((category) => categoryCounts.set(category, (categoryCounts.get(category) || 0) + 1)));
/* Most-filed first, so the index reads as what the notes are about; ties in
   name order so the tail is stable. */
const categories = [...categoryCounts].sort(([a, countA], [b, countB]) => countB - countA || a.localeCompare(b));
---

<SiteLayout
  activeApp="blog"
  canonicalOrigin="https://oponomarov.com"
  title="Engineering notes"
  description={pageDescriptions.blog}
  searchType="Overview"
  rssHref="/blog/feed.xml"
>
  <main id="main-content" class="content-grid" tabindex="-1">
    <section class="hero section-shell" aria-labelledby="page-title">
      <h1 id="page-title">Engineering notes<span class="hero-cursor" aria-hidden="true"></span></h1>
      <p class="hero-lead">{pageDescriptions.blog}</p>
      <div class="hero-actions">
        <a class="secondary-link" href="/blog/feed.xml">RSS feed →</a>
      </div>
    </section>

    <section class="archive section full-bleed content-grid" id="notes" aria-labelledby="notes-title" data-pagefind-ignore>
      <div class="section-shell archive-shell">
        <header class="section-heading archive-heading">
          <h2 id="notes-title">All notes</h2>
          {/* The intro and the topic directory describe a list that exists; with
              no notes yet the heading stands alone over one honest line. */}
          {posts.length > 0 && <div class="prose"><p class="archive-intro">Browse chronologically, or jump straight to the systems and tools you care about.</p></div>}
          {categories.length > 0 && (
            <nav class="topic-directory" aria-labelledby="topic-directory-title">
              <p class="topic-directory-label" id="topic-directory-title">Browse by topic</p>
              <ul>
                {categories.map(([category, count]) => (
                  <li><a href={`/blog/categories/${category}/`}><span class="topic-directory-tag">{topicTag(category)}</span><span class="topic-directory-count" aria-label={`${count} ${count === 1 ? "note" : "notes"}`}>{count}</span></a></li>
                ))}
              </ul>
            </nav>
          )}
        </header>
        <div class="archive-years">
          {posts.length === 0 && <div class="empty-state"><p>No notes yet.</p><a href="/">Back to the portfolio →</a></div>}
          {[...years].map(([year, yearPosts]) => (
            <section class="archive-year" aria-labelledby={`year-${year}`}>
              <h3 id={`year-${year}`}>{year}</h3>
              <ol class="article-list">
                {yearPosts.map((post) => (
                  <li class="article-row">
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, "dayMonth")}</time>
                    <a class="article-title" href={`/blog/posts/${slugForPost(post)}/`}>{post.data.title}</a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
