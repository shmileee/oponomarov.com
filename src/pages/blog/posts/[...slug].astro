---
import { getCollection, render } from "astro:content";
import ArticleShell from "../../../components/ArticleShell.astro";
import PageToc from "../../../components/PageToc.astro";
import SiteLayout from "../../../components/SiteLayout.astro";
import { plainText, renderInline } from "../../../lib/inline-markdown";
import { slugForPost, sortPosts } from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection("posts"));
  return posts.map((post, index) => ({
    params: { slug: slugForPost(post) },
    props: { post, older: posts[index + 1], newer: posts[index - 1] },
  }));
}

const { post, older, newer } = Astro.props;
const { Content, headings } = await render(post);
const readingMinutes = Math.floor((post.body || "").split(/\s+/).length / 220) + 1;
---

<SiteLayout
  activeApp="blog"
  canonicalOrigin="https://oponomarov.com"
  title={post.data.title}
  description={plainText(post.data.description)}
  article
  searchType="Note"
  publishedTime={post.data.date}
  tags={post.data.categories}
  rssHref="/blog/feed.xml"
>
  <ArticleShell
    title={post.data.title}
    descriptionHtml={renderInline(post.data.description)}
    backLink={{ href: "/blog/", title: "all notes" }}
    publishedTime={post.data.date}
    readingMinutes={readingMinutes}
    previous={older && { href: `/blog/posts/${slugForPost(older)}/`, title: older.data.title, label: "← Older" }}
    next={newer && { href: `/blog/posts/${slugForPost(newer)}/`, title: newer.data.title, label: "Newer →" }}
    adjacentLabel="Adjacent notes"
  >
    <ul slot="topics" class="topic-list" aria-label="Topics" data-pagefind-ignore>
      {post.data.categories.map((category: string) => <li><a href={`/blog/categories/${category}/`}>{category}</a></li>)}
    </ul>
    <PageToc slot="toc" headings={headings} />
    <Content />
    <section slot="comments" class="comments-region" aria-labelledby="comments-title" data-pagefind-ignore><h2 id="comments-title">Comments</h2><div id="comments"></div></section>
  </ArticleShell>

  <script is:inline>
    function loadGiscusComments() {
      const script = document.createElement("script");
      script.src = "https://giscus.app/client.js";
      script.async = true;
      script.crossOrigin = "anonymous";
      const settings = {
        repo: "shmileee/blog",
        "repo-id": "R_kgDONajVjQ",
        category: "Comments",
        "category-id": "DIC_kwDONajVjc4ClC6H",
        mapping: "pathname",
        strict: "1",
        "reactions-enabled": "0",
        "emit-metadata": "0",
        "input-position": "top",
        theme: document.documentElement.dataset.theme === "light" ? "light" : "transparent_dark",
        lang: "en",
        loading: "lazy",
      };
      Object.entries(settings).forEach(([key, value]) => script.setAttribute(`data-${key}`, value));
      document.getElementById("comments")?.appendChild(script);
    }
    let scriptLoaded = false;
    function loadCommentScriptOnce() {
      if (scriptLoaded) return;
      loadGiscusComments();
      scriptLoaded = true;
    }
    setTimeout(loadCommentScriptOnce, 5000);
    window.addEventListener("scroll", loadCommentScriptOnce, { once: true, passive: true });
    window.addEventListener("om-theme-change", (event) => {
      const frame = document.querySelector("iframe.giscus-frame");
      if (!frame) return;
      frame.contentWindow?.postMessage({ giscus: { setConfig: { theme: event.detail === "light" ? "light" : "transparent_dark" } } }, "https://giscus.app");
    });
  </script>
</SiteLayout>
