---
import { getCollection, render } from "astro:content";
import EditorialLayout from "../../../components/EditorialLayout.astro";
import { slugForPost, sortPosts } from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection("posts"));
  return posts.map((post, index) => ({
    params: { slug: slugForPost(post) },
    props: { post, older: posts[index + 1], newer: posts[index - 1] },
  }));
}

const { post, older, newer } = Astro.props;
const { Content } = await render(post);
const readingMinutes = Math.floor((post.body || "").split(/\s+/).length / 220) + 1;
const longDate = new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "long", year: "numeric" }).format(post.data.date);
---

<EditorialLayout
  site="blog"
  canonicalOrigin="https://oponomarov.com"
  title={post.data.title}
  description={post.data.description}
  article
  searchType="Note"
  publishedTime={post.data.date}
  tags={post.data.categories}
>
  <main id="main-content" class="page-shell post-page-shell" data-pagefind-body>
    <article class="post-detail">
      <header class="detail-header post-header">
        <a class="back-link" href="/blog/">← all notes</a>
        <h1>{post.data.title}</h1>
        <p class="post-dek">{post.data.description}</p>
        <p class="post-meta"><time datetime={post.data.date.toISOString()}>{longDate}</time><span aria-hidden="true">·</span><span>{readingMinutes} min read</span></p>
        <ul class="topic-list post-topics" aria-label="Topics">
          {post.data.categories.map((category: string) => <li><a href={`/blog/categories/${category}/`}>{category}</a></li>)}
        </ul>
      </header>

      <div class="post-content-layout">
        <nav class="article-toc" aria-label="Article contents" data-article-toc data-pagefind-ignore hidden>
          <div class="article-toc-rail"><p class="article-toc-title">Contents</p><ol data-article-toc-list></ol></div>
          <label class="article-toc-picker"><span>Jump to</span><span class="article-toc-select-wrap"><select aria-label="Jump to a section" data-article-toc-select><option value="">Choose a section</option></select></span></label>
        </nav>

        <div class="post-reading-column">
          <div class="prose"><Content /></div>
          {(older || newer) && (
            <nav class="post-navigation" aria-label="Adjacent notes" data-pagefind-ignore>
              <p class="section-eyebrow">Next in the archive</p>
              <div class="post-navigation-grid">
                {older && <a href={`/blog/posts/${slugForPost(older)}/`}><span class="post-navigation-kicker">← Older</span><strong>{older.data.title}</strong></a>}
                {newer && <a class="post-navigation-next" href={`/blog/posts/${slugForPost(newer)}/`}><span class="post-navigation-kicker">Newer →</span><strong>{newer.data.title}</strong></a>}
              </div>
            </nav>
          )}
          <section class="comments-region" aria-labelledby="comments-title" data-pagefind-ignore><h2 id="comments-title">Comments</h2><div id="comments"></div></section>
        </div>
      </div>
    </article>
  </main>

  <script is:inline>
    function loadGiscusComments() {
      const script = document.createElement("script");
      script.src = "https://giscus.app/client.js";
      script.async = true;
      script.crossOrigin = "anonymous";
      const settings = {
        repo: "shmileee/blog",
        "repo-id": "R_kgDONajVjQ",
        category: "Comments",
        "category-id": "DIC_kwDONajVjc4ClC6H",
        mapping: "pathname",
        strict: "1",
        "reactions-enabled": "0",
        "emit-metadata": "0",
        "input-position": "top",
        theme: document.documentElement.dataset.theme === "light" ? "light" : "transparent_dark",
        lang: "en",
        loading: "lazy",
      };
      Object.entries(settings).forEach(([key, value]) => script.setAttribute(`data-${key}`, value));
      document.getElementById("comments")?.appendChild(script);
    }
    let scriptLoaded = false;
    function loadCommentScriptOnce() {
      if (scriptLoaded) return;
      loadGiscusComments();
      scriptLoaded = true;
    }
    setTimeout(loadCommentScriptOnce, 5000);
    window.addEventListener("scroll", loadCommentScriptOnce, { once: true, passive: true });
    window.addEventListener("om-theme-change", (event) => {
      const frame = document.querySelector("iframe.giscus-frame");
      if (!frame) return;
      frame.contentWindow?.postMessage({ giscus: { setConfig: { theme: event.detail === "light" ? "light" : "transparent_dark" } } }, "https://giscus.app");
    });
  </script>
</EditorialLayout>
