---
import { getCollection, render } from "astro:content";
import ArticleShell from "../../../components/ArticleShell.astro";
import PageToc from "../../../components/PageToc.astro";
import SiteLayout from "../../../components/SiteLayout.astro";
import { inlineContexts, plainText, renderInline } from "../../../lib/inline-markdown";
import { topicTag } from "../../../lib/topic-labels";
import { postRoutes, slugForPost, sortPosts } from "../../../lib/posts";
import { readingMinutes } from "../../../lib/reading-time";

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection("posts"));
  /* One route per post and one per alias it declares; an alias route is a
     redirect page to the canonical slug (postRoutes fails the build on a
     collision). Comments are keyed by pathname (giscus below), so a rename
     moves a note's thread: the alias keeps the link working, not the thread. */
  return postRoutes(posts).map(({ slug, post, redirect }) => {
    const index = posts.indexOf(post);
    return { params: { slug }, props: { post, older: posts[index + 1], newer: posts[index - 1], redirect } };
  });
}

const { post, older, newer, redirect } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingMinutes(post.body);
const href = `/blog/posts/${slugForPost(post)}/`;
---

{redirect ? (
  <SiteLayout
    activeApp="blog"
    canonicalOrigin="https://oponomarov.com"
    canonicalPath={href}
    title={post.data.title}
    description={plainText(post.data.description)}
    robots="noindex,follow"
    indexable={false}
  >
    <Fragment slot="head">
      <meta http-equiv="refresh" content={`0; url=${href}`} />
      <script is:inline define:vars={{ target: href }}>location.replace(target + location.search + location.hash);</script>
    </Fragment>
    <main id="main-content" class="content-grid" tabindex="-1">
      <div class="prose"><p>Moved to <a href={href}>{post.data.title}</a>.</p></div>
    </main>
  </SiteLayout>
) : <SiteLayout
  activeApp="blog"
  canonicalOrigin="https://oponomarov.com"
  title={post.data.title}
  description={plainText(post.data.description)}
  article
  searchType="Note"
  publishedTime={post.data.date}
  tags={post.data.categories}
  rssHref="/blog/feed.xml"
>
  <ArticleShell
    title={post.data.title}
    descriptionHtml={renderInline(post.data.description, inlineContexts.lede)}
    backLink={{ href: "/blog/", title: "all notes" }}
    publishedTime={post.data.date}
    readingMinutes={minutes}
    previous={older && { href: `/blog/posts/${slugForPost(older)}/`, title: older.data.title, label: "← Older" }}
    next={newer && { href: `/blog/posts/${slugForPost(newer)}/`, title: newer.data.title, label: "Newer →" }}
    adjacentLabel="Adjacent notes"
  >
    <ul slot="topics" class="topic-list" aria-label="Topics" data-pagefind-ignore>
      {post.data.categories.map((category: string) => <li><a href={`/blog/categories/${category}/`}>{topicTag(category)}</a></li>)}
    </ul>
    <PageToc slot="toc" headings={headings} />
    <Content />
    <section slot="comments" class="comments-region" aria-labelledby="comments-title" data-pagefind-ignore><h2 id="comments-title">Comments</h2><div id="comments"></div></section>
  </ArticleShell>

  {/* data-astro-rerun: the client router only re-executes an inline script
      whose text changed, and this one is identical on every note, so without
      it the second note visited never loaded its comments. */}
  <script is:inline data-astro-rerun>
    (() => {
      const container = document.getElementById("comments");
      if (!container) return;
      const load = () => {
        /* Once per article, and never into a container the router has already
           swapped away: a timer started on the previous note must not plant
           its widget on this one. */
        if (container.dataset.loaded === "true" || !container.isConnected) return;
        container.dataset.loaded = "true";
        const script = document.createElement("script");
        script.src = "https://giscus.app/client.js";
        script.async = true;
        script.crossOrigin = "anonymous";
        const settings = {
          repo: "shmileee/blog",
          "repo-id": "R_kgDONajVjQ",
          category: "Comments",
          "category-id": "DIC_kwDONajVjc4ClC6H",
          mapping: "pathname",
          strict: "1",
          "reactions-enabled": "0",
          "emit-metadata": "0",
          "input-position": "top",
          theme: document.documentElement.dataset.theme === "light" ? "light" : "transparent_dark",
          lang: "en",
          loading: "lazy",
        };
        Object.entries(settings).forEach(([key, value]) => script.setAttribute(`data-${key}`, value));
        container.appendChild(script);
      };
      setTimeout(load, 5000);
      window.addEventListener("scroll", load, { once: true, passive: true });
      if (!window.omGiscusThemeBound) {
        window.omGiscusThemeBound = true;
        window.addEventListener("om-theme-change", (event) => {
          const frame = document.querySelector("iframe.giscus-frame");
          if (!frame) return;
          frame.contentWindow?.postMessage({ giscus: { setConfig: { theme: event.detail === "light" ? "light" : "transparent_dark" } } }, "https://giscus.app");
        });
      }
    })();
  </script>
</SiteLayout>}
