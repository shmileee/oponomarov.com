---
import { getCollection, render } from "astro:content";
import SiteLayout from "../components/SiteLayout.astro";
import { collectTopics, formatCaseNumber, loadCaseStudies, requireCaseStudy } from "../lib/case-studies";
import { inlineContexts, renderInline } from "../lib/inline-markdown";
import { topicTag } from "../lib/topic-labels";
import { pageDescriptions } from "../lib/site-metadata";

const studies = await loadCaseStudies();
/* The spotlight is whichever study the content marks; with none marked the
   section is simply absent rather than the build failing. */
const spotlight = studies.find(({ entry }) => entry.data.spotlight);

const homeEntries = await getCollection("home");
const homeByKey = new Map(homeEntries.map((entry) => [entry.data.key, entry]));
const requireHome = (key: string) => {
  const entry = homeByKey.get(key);
  if (!entry) throw new Error(`content/home/ has no entry with key "${key}" (expected ${key}.md).`);
  return entry;
};
const hero = requireHome("hero");
const hiring = await render(requireHome("hiring"));
const HiringContent = hiring.Content;
const arcIntroEntry = requireHome("arc");
const arcIntro = await render(arcIntroEntry);
const ArcIntroContent = arcIntro.Content;
const arcEntries = (await getCollection("arc")).sort((a, b) => a.data.number - b.data.number);
const renderedArc = await Promise.all(arcEntries.map(async (entry) => ({
  entry,
  Content: (await render(entry)).Content,
  links: entry.data.links.map((link) => ({ label: link.label, study: requireCaseStudy(studies, link.study, `Arc step ${entry.data.number} (${entry.id})`) })),
})));
const principleEntries = (await getCollection("principles")).sort((a, b) => a.data.number - b.data.number);
const renderedPrinciples = await Promise.all(principleEntries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));

/* Filter buttons come from the studies themselves: the known topics keep
   this order, and a topic that appears for the first time is appended. */
const topics = collectTopics(studies, ["reliability", "networking", "devex", "security", "ai", "cost", "delivery"]);
const initiallyVisible = 9;
const readerManifest = studies.map((study) => ({
  id: study.folder,
  aliases: study.aliases,
  number: study.number,
  url: study.href,
  title: study.entry.data.title,
  /* Rendered here so the reader shows the same dek the study page does;
     renderInline escapes the source, so this is the only HTML it carries. */
  summaryHtml: renderInline(study.entry.data.summary, inlineContexts.lede),
  /* Tags, so the dialog reads as the page does. */
  topics: study.entry.data.topics.map(topicTag),
}));
---

<SiteLayout
  activeApp="portfolio"
  canonicalOrigin="https://oponomarov.com"
  title="Portfolio"
  description={pageDescriptions.home}
  searchType="Overview"
>
  <main id="main-content" class="content-grid" tabindex="-1">
    <section class="hero section-shell" id="top">
      <h1>{hero.data.title}<span class="hero-cursor" aria-hidden="true"></span></h1>
      <div class="hero-copy prose prose--lede"><HiringContent /></div>
      <div class="hero-actions">
        <a class="primary-link" href={hero.data.primaryHref}>{hero.data.primaryCta}</a>
        <a class="secondary-link" href={hero.data.secondaryHref}>{hero.data.secondaryCta}</a>
      </div>
    </section>

    <section class="section full-bleed" id="arc">
      <div class="section-shell content-grid">
        <p class="eyebrow">{arcIntroEntry.data.eyebrow}</p>
        <h2>{arcIntroEntry.data.title}</h2>
        <div class="prose"><ArcIntroContent /></div>
        <div class="arc-list wide">
          {renderedArc.map(({ entry, Content, links }, index) => (
            <article class="arc-step">
              <span class="arc-number">{String(entry.data.number).padStart(2, "0")}</span>
              <div class="arc-content">
                <div class="arc-copy prose"><Content /></div>
                <div class="arc-links">
                  {links.map(({ label, study }) => (
                    <a href={study.href} data-open-study={study.folder} data-arc-study={study.folder}>{formatCaseNumber(study.number)} · {label}</a>
                  ))}
                </div>
              </div>
              {index < renderedArc.length - 1 && <span class="arc-arrow" aria-hidden="true">↓</span>}
            </article>
          ))}
        </div>
      </div>
    </section>

    {spotlight && (
      <section class="section" id="featured">
        <div class="section-shell">
          <p class="eyebrow">02</p>
          <h2>The biggest win</h2>
          <article class="spotlight" data-pagefind-ignore>
            <header class="spotlight-header">
              <p class="reader-meta">Case study {formatCaseNumber(spotlight.number)} · spotlight</p>
              <h3>{spotlight.entry.data.title}</h3>
              {spotlight.entry.data.role && spotlight.entry.data.evidence && (
                <dl class="case-proof spotlight-proof" data-case-proof>
                  <div><dt>Impact</dt><dd set:html={renderInline(spotlight.entry.data.summary, inlineContexts.card)} /></div>
                  <div><dt>My role</dt><dd set:html={renderInline(spotlight.entry.data.role, inlineContexts.card)} /></div>
                  <div><dt>Evidence</dt><dd set:html={renderInline(spotlight.entry.data.evidence, inlineContexts.card)} /></div>
                </dl>
              )}
              {spotlight.entry.data.spotlightProof && <div class="prose"><p set:html={renderInline(spotlight.entry.data.spotlightProof)} /></div>}
              <div class="topic-list" aria-label="Topics">{spotlight.entry.data.topics.map((topic) => <span>{topicTag(topic)}</span>)}</div>
            </header>
            <div class="hero-actions"><a class="primary-link" href={spotlight.href} data-open-study={spotlight.folder}>Read case study →</a></div>
          </article>
        </div>
      </section>
    )}

    <section class="section full-bleed" id="index">
      <div class="section-shell content-grid">
        <p class="eyebrow">{spotlight ? "03" : "02"}</p>
        <h2>All case studies</h2>
        {studies.length === 0 && <div class="empty-state"><p>No case studies published yet.</p><a href="/blog/">Read the engineering notes →</a></div>}
        {studies.length > 0 && (
          <div class="topic-filters" role="group" aria-label="Filter case studies">
            <button type="button" data-topic-filter="all" aria-pressed="true">all</button>
            {topics.map((topic) => <button type="button" data-topic-filter={topic} aria-pressed="false">{topicTag(topic)}</button>)}
          </div>
        )}
        {/* The count was a screen-reader-only live region; sighted readers
            had no way to tell that nine of twenty-two cards were showing. */}
        <p class="filter-status" aria-live="polite" data-filter-status></p>
        <div class="case-grid wide" data-case-grid data-pagefind-ignore>
          {studies.map((study, index) => (
            <a class:list={["case-card", { "case-card-featured": study.entry.data.featured }]} href={study.href} data-case-card data-open-study={study.folder} data-topics={study.entry.data.topics.join("|")} data-initially-hidden={String(index >= initiallyVisible)}>
              <span class="case-card-number">{formatCaseNumber(study.number)}{study.entry.data.featured && " · featured"}{study.entry.data.cardLabel && ` · ${study.entry.data.cardLabel}`}</span>
              <span class="case-card-title">{study.entry.data.title}</span>
              {study.entry.data.role && study.entry.data.evidence ? (
                <dl class="case-proof case-card-proof" data-case-proof>
                  <div><dt>Impact</dt><dd set:html={renderInline(study.entry.data.summary, inlineContexts.card)} /></div>
                  <div><dt>My role</dt><dd set:html={renderInline(study.entry.data.role, inlineContexts.card)} /></div>
                  <div><dt>Evidence</dt><dd set:html={renderInline(study.entry.data.evidence, inlineContexts.card)} /></div>
                </dl>
              ) : <span class="case-card-summary" set:html={renderInline(study.entry.data.summary, inlineContexts.card)} />}
              <span class="case-card-topics">{study.entry.data.topics.map((topic) => <span>{topicTag(topic)}</span>)}</span>
              <span class="case-card-action">{study.entry.data.spotlight ? "full story ↑" : "read →"}</span>
            </a>
          ))}
        </div>
        {studies.length > initiallyVisible && <div class="grid-toggle-row"><button class="grid-toggle" type="button" data-grid-toggle>see more →</button></div>}
      </div>
    </section>

    <section class="section" id="how-i-work">
      <div class="section-shell" id="principles">
        <p class="eyebrow">{spotlight ? "04" : "03"}</p>
        <h2>How I work</h2>
        <div class="principle-list">
          {renderedPrinciples.map(({ entry, Content }) => (
            <article class="principle"><span>{String(entry.data.number).padStart(2, "0")}</span><div class="prose"><h3>{entry.data.title}</h3><Content /></div></article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <dialog class="reader" id="case-study-reader" aria-labelledby="reader-title" data-reader>
    <div class="reader-shell">
      <div class="reader-toolbar">
        {/* The study's own address: the dialog is a reading view over the
            homepage, and a reader who wants the page (to share it, to keep
            it in a tab, to print it) had no way there but the URL bar. */}
        <a class="reader-permalink" href="/" data-reader-permalink>Open as page →</a>
        <button class="reader-close" type="button" aria-label="Close case study" title="Close case study" data-reader-close>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 4 8 8m0-8-8 8"></path></svg>
        </button>
      </div>
      <article class="reader-study" data-reader-study>
        <p class="reader-meta"><span class="reader-meta-number" data-reader-meta-number></span><span class="reader-meta-topics" data-reader-meta-topics></span></p>
        <h2 class="reader-title" id="reader-title" tabindex="-1" data-reader-title>Case study reader</h2>
        <p class="reader-dek prose prose--lede" data-reader-dek></p>
        <p class="sr-only" role="status" aria-live="polite" data-reader-status>Choose a case study to read.</p>
        <div class="prose reader-prose" data-reader-prose></div>
        <nav class="reader-navigation" aria-label="Case study navigation">
          <button type="button" data-reader-direction="previous"><span data-reader-direction-kicker></span><span data-reader-case-number></span><span data-reader-case-title></span></button>
          <button type="button" data-reader-direction="next"><span data-reader-direction-kicker></span><span data-reader-case-number></span><span data-reader-case-title></span></button>
        </nav>
      </article>
    </div>
    <script is:inline type="application/json" data-reader-manifest set:html={JSON.stringify(readerManifest)}></script>
  </dialog>

  <!-- Homepage-only: topic filtering, the see-more toggle, and the reader.
       Site-wide behaviour lives in SiteHeader. -->
  <script>import "../scripts/study-index.js";</script>
</SiteLayout>
