---
import { getCollection, render } from "astro:content";
import ArticleShell from "../../components/ArticleShell.astro";
import SiteLayout from "../../components/SiteLayout.astro";
import { caseStudyCatalog } from "../../lib/catalog";

export async function getStaticPaths() {
  const studies = await getCollection("caseStudies");
  const studyByFolder = new Map(studies.map((study) => [study.id.replace(/\/index$/, ""), study]));
  return caseStudyCatalog.flatMap((entry, index) => {
    const props = {
      entry,
      study: studyByFolder.get(entry.folder)!,
      previous: caseStudyCatalog[(index - 1 + caseStudyCatalog.length) % caseStudyCatalog.length],
      next: caseStudyCatalog[(index + 1) % caseStudyCatalog.length],
      previousStudy: studyByFolder.get(caseStudyCatalog[(index - 1 + caseStudyCatalog.length) % caseStudyCatalog.length].folder)!,
      nextStudy: studyByFolder.get(caseStudyCatalog[(index + 1) % caseStudyCatalog.length].folder)!,
    };
    return [
      { params: { slug: entry.folder }, props: { ...props, redirect: false } },
      { params: { slug: entry.legacyFolder }, props: { ...props, redirect: true } },
    ];
  });
}

const { entry, study, previous, next, previousStudy, nextStudy, redirect } = Astro.props;
const { Content } = await render(study);
const target = `/case-studies/${entry.folder}/`;
---

{redirect ? (
  <SiteLayout
    activeApp="portfolio"
    canonicalOrigin="https://oponomarov.com"
    canonicalPath={target}
    title="Case study moved"
    description={study.data.summary}
    robots="noindex,follow"
    indexable={false}
    ogImage="https://oponomarov.com/assets/og-image.png"
  >
    <Fragment slot="head">
      <meta http-equiv="refresh" content={`0; url=${target}`} />
      <script is:inline define:vars={{ target }}>location.replace(target + location.search + location.hash);</script>
    </Fragment>
    <main id="main-content" class="content-grid" tabindex="-1">
      <div class="prose"><p>Moved to <a href={target}>{study.data.title}</a>.</p></div>
    </main>
  </SiteLayout>
) : <SiteLayout
  activeApp="portfolio"
  canonicalOrigin="https://oponomarov.com"
  title={study.data.title}
  description={study.data.summary}
  article
  searchType="Case study"
  tags={study.data.topics}
  ogImage="https://oponomarov.com/assets/og-image.png"
>
  <ArticleShell
    title={study.data.title}
    description={study.data.summary}
    eyebrow={`Case study ${String(entry.number).padStart(2, "0")}${study.data.featured ? " · featured" : ""}`}
    backLink={{ href: "/#index", title: "← all case studies" }}
    previous={{
      href: `/case-studies/${previous.folder}/`,
      title: previousStudy.data.title,
      label: `Previous Case ${String(previous.number).padStart(2, "0")}`,
    }}
    next={{
      href: `/case-studies/${next.folder}/`,
      title: nextStudy.data.title,
      label: `Next Case ${String(next.number).padStart(2, "0")}`,
    }}
    adjacentLabel="Adjacent case studies"
  >
    <Fragment slot="proof">
      {study.data.role && study.data.evidence && (
        <dl class="case-proof" data-case-proof>
          <div><dt>Impact</dt><dd>{study.data.summary}</dd></div>
          <div><dt>My role</dt><dd>{study.data.role}</dd></div>
          <div><dt>Evidence</dt><dd>{study.data.evidence}</dd></div>
        </dl>
      )}
    </Fragment>
    <div slot="topics" class="topic-list" aria-label="Topics">{study.data.topics.map((topic: string) => <span>{topic}</span>)}</div>
    <Content />
    <nav slot="footer" class="link-row" aria-label="Portfolio navigation" data-pagefind-ignore>
      <a href="/#index">View all work →</a>
      <a href="/contact/">Contact</a>
    </nav>
  </ArticleShell>
</SiteLayout>}
