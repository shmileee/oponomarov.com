---
import { render } from "astro:content";
import ArticleShell from "../../components/ArticleShell.astro";
import PageToc from "../../components/PageToc.astro";
import SiteLayout from "../../components/SiteLayout.astro";
import { adjacentCaseStudies, formatCaseNumber, loadCaseStudies, type CaseStudy } from "../../lib/case-studies";
import { topicTag } from "../../lib/topic-labels";
import { inlineContexts, plainText, renderInline } from "../../lib/inline-markdown";
import { readingMinutes } from "../../lib/reading-time";

export async function getStaticPaths() {
  const studies = await loadCaseStudies();
  return studies.flatMap((study) => [
    { params: { slug: study.folder }, props: { study, redirect: false } },
    /* Every alias a study declares (its old numbered slug, an old reader id)
       is a redirect page to the canonical folder. */
    ...study.aliases.map((alias) => ({ params: { slug: alias }, props: { study, redirect: true } })),
  ]);
}

interface Props {
  study: CaseStudy;
  redirect: boolean;
}

const { study, redirect } = Astro.props;
const studies = await loadCaseStudies();
const { previous, next } = adjacentCaseStudies(studies, study);
/* A case study is a sectioned document like a manual or a note, so it takes the
   same table of contents they do: the rule is "every article rendered through
   ArticleShell gets one", not "whichever routes happened to pass headings". */
const { Content, headings } = await render(study.entry);
const { data } = study.entry;
const description = plainText(data.description ?? data.summary);
---

{redirect ? (
  <SiteLayout
    activeApp="portfolio"
    canonicalOrigin="https://oponomarov.com"
    canonicalPath={study.href}
    title={data.title}
    description={description}
    robots="noindex,follow"
    indexable={false}
  >
    <Fragment slot="head">
      <meta http-equiv="refresh" content={`0; url=${study.href}`} />
      <script is:inline define:vars={{ target: study.href }}>location.replace(target + location.search + location.hash);</script>
    </Fragment>
    <main id="main-content" class="content-grid" tabindex="-1">
      <div class="prose"><p>Moved to <a href={study.href}>{data.title}</a>.</p></div>
    </main>
  </SiteLayout>
) : <SiteLayout
  activeApp="portfolio"
  canonicalOrigin="https://oponomarov.com"
  title={data.title}
  description={description}
  article
  searchType="Case study"
  tags={data.topics}
>
  <ArticleShell
    title={data.title}
    descriptionHtml={renderInline(data.summary, inlineContexts.lede)}
    eyebrow={`Case study ${formatCaseNumber(study.number)}${data.featured ? " · featured" : ""}`}
    periodLabel={data.period}
    readingMinutes={readingMinutes(study.entry.body)}
    backLink={{ href: "/#index", title: "all case studies" }}
  >
    <Fragment slot="proof">
      {/* The dek above is the study's impact line, so the proof list carries
          the other two facts; repeating the summary as "Impact" printed the
          same sentence twice within sixty pixels. */}
      {data.role && data.evidence && (
        <dl class="case-proof" data-case-proof>
          <div><dt>My role</dt><dd set:html={renderInline(data.role, inlineContexts.card)} /></div>
          <div><dt>Evidence</dt><dd set:html={renderInline(data.evidence, inlineContexts.card)} /></div>
        </dl>
      )}
    </Fragment>
    <div slot="topics" class="topic-list" aria-label="Topics" data-pagefind-ignore>{data.topics.map((topic: string) => <span>{topicTag(topic)}</span>)}</div>
    <PageToc slot="toc" headings={headings} />
    <Content />
    {/* The series card closes the article body rather than the page: the
        homepage reader loads the body, so a study that continues elsewhere
        says so in the dialog too, and the reader opens the link in place. */}
    {(study.series.prequel || study.series.sequel) && (
      <nav class="series-nav" aria-label="Series" data-pagefind-ignore>
        {study.series.prequel && (
          <a href={study.series.prequel.href}>
            <span class="series-nav__label">Continues from</span>
            <span class="series-nav__number">Case {formatCaseNumber(study.series.prequel.number)}</span>
            <strong class="series-nav__title">{study.series.prequel.entry.data.title}</strong>
          </a>
        )}
        {study.series.sequel && (
          <a class="series-nav__next" href={study.series.sequel.href}>
            <span class="series-nav__label">Continues in</span>
            <span class="series-nav__number">Case {formatCaseNumber(study.series.sequel.number)}</span>
            <strong class="series-nav__title">{study.series.sequel.entry.data.title}</strong>
          </a>
        )}
      </nav>
    )}
    <Fragment slot="footer">
      {/* The published adjacent cards stack kicker, case number and title on
          three lines; the shared shell renders a single label, so the case
          study composes the nav itself from the same primitives. */}
      <nav class="adjacent-nav" aria-label="Adjacent case studies" data-pagefind-ignore>
        <a href={previous.href} rel="prev" data-study-direction="previous">
          <span class="adjacent-nav__label">Previous</span>
          <span class="adjacent-nav__number">Case {formatCaseNumber(previous.number)}</span>
          <strong class="adjacent-nav__title">{previous.entry.data.title}</strong>
        </a>
        <a class="adjacent-nav__next" href={next.href} rel="next" data-study-direction="next">
          <span class="adjacent-nav__label">Next</span>
          <span class="adjacent-nav__number">Case {formatCaseNumber(next.number)}</span>
          <strong class="adjacent-nav__title">{next.entry.data.title}</strong>
        </a>
      </nav>
      <nav class="link-row" aria-label="Portfolio navigation" data-pagefind-ignore>
        <a href="/#index">View all work →</a>
        <a href="/contact/">Contact</a>
      </nav>
    </Fragment>
  </ArticleShell>
</SiteLayout>}
