---
import { render } from "astro:content";
import SiteLayout from "../../components/SiteLayout.astro";
import { adjacentDocs, loadDocs } from "../../lib/docs";

const pages = await loadDocs();
const page = pages.find((candidate) => candidate.slug === "")!;
const { Content } = await render(page.entry);
const { next } = adjacentDocs(pages, page);
---

<SiteLayout
  activeApp="dotfiles"
  title={page.entry.data.title}
  description={page.entry.data.description}
  searchType="Documentation"
>
  {/* A hub, not an article: no table of contents, no header block. It runs
      in the article composition (layout.css) so its column, hero and
      next-card sit exactly where the manuals' do, and `data-landing` lets its
      card grids and step lists take the wide track the way the homepage's
      case-study index does (primitives.css). */}
  <main id="main-content" class="article content-grid" tabindex="-1">
    <div class="prose content-grid full-bleed" data-landing>
      <Content />
    </div>
    {next && (
      <nav class="adjacent-nav" aria-label="Adjacent documentation" data-pagefind-ignore>
        <a class="adjacent-nav__next" href={next.href} rel="next">
          <span class="adjacent-nav__label">Next →</span>
          <strong class="adjacent-nav__title">{next.title}</strong>
        </a>
      </nav>
    )}
  </main>
</SiteLayout>
