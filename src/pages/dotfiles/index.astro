---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../components/SiteLayout.astro";
import { docsNavigation as docsNav, docsHref as docsUrl, docsSlug } from "../../lib/docs";

const entry = (await getCollection("docs")).find((item) => docsSlug(item) === "");
if (!entry) throw new Error("Missing Dotfiles overview content");
const { Content } = await render(entry);
const currentIndex = docsNav.findIndex((item) => item.slug === docsSlug(entry));
const next = currentIndex >= 0 && currentIndex < docsNav.length - 1 ? docsNav[currentIndex + 1] : undefined;
---

<SiteLayout
  activeApp="dotfiles"
  title={entry.data.title}
  description={entry.data.description}
  searchType="Documentation"
>
  {/* The published landing page ran in the centred reading column with no
      table of contents; the article composition (layout.css) is that column,
      so the landing body and its next-card sit exactly where the manuals' do. */}
  <main id="main-content" class="article content-grid" tabindex="-1">
    <div class="prose content-grid full-bleed">
      <Content />
    </div>
    {next && (
      <nav class="adjacent-nav" aria-label="Adjacent documentation" data-pagefind-ignore>
        <a class="adjacent-nav__next" href={docsUrl(next.slug)} rel="next">
          <span class="adjacent-nav__label">Next →</span>
          <strong class="adjacent-nav__title">{next.label}</strong>
        </a>
      </nav>
    )}
  </main>
</SiteLayout>
