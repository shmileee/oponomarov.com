---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DocsLayout from "../../components/DocsLayout.astro";
import { docsSlug } from "../../lib/docs";

export async function getStaticPaths() {
  const entries = (await getCollection("docs")).filter((entry) => docsSlug(entry));
  return entries.map((entry) => ({ params: { slug: docsSlug(entry) }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"docs">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout entry={entry} headings={headings}>
  <Content />
</DocsLayout>
