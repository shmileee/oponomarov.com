---
import { render } from "astro:content";
import ArticleShell from "../../components/ArticleShell.astro";
import PageToc from "../../components/PageToc.astro";
import SiteLayout from "../../components/SiteLayout.astro";
import { adjacentDocs, loadDocs, type DocsPage } from "../../lib/docs";
import { inlineContexts, plainText, renderInline } from "../../lib/inline-markdown";

export async function getStaticPaths() {
  const pages = await loadDocs();
  return pages.filter((page) => page.slug).map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props {
  page: DocsPage;
}

const { page } = Astro.props;
const pages = await loadDocs();
const { Content, headings } = await render(page.entry);
const { previous, next } = adjacentDocs(pages, page);
const rawUrl = page.entry.data.editUrl?.replace("/edit/", "/raw/");
---

<SiteLayout
  activeApp="dotfiles"
  title={page.entry.data.title}
  description={plainText(page.entry.data.description)}
  searchType="Documentation"
  showProgress
>
  <ArticleShell
    title={page.entry.data.title}
    descriptionHtml={renderInline(page.entry.data.description, inlineContexts.lede)}
    backLink={{ href: "/dotfiles/", title: "dotfiles overview" }}
    previous={previous && { href: previous.href, title: previous.title }}
    next={next && { href: next.href, title: next.title }}
    adjacentLabel="Adjacent documentation"
  >
    {page.entry.data.editUrl && (
      <p slot="actions" class="page-source-actions">
        {rawUrl && <a href={rawUrl} aria-label="View source of this page" title="View source">View source</a>}
        <a href={page.entry.data.editUrl} aria-label="Edit this page" title="Edit this page">Edit this page</a>
      </p>
    )}
    <PageToc slot="toc" headings={headings} />
    <Content />
  </ArticleShell>
</SiteLayout>
