---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ArticleShell from "../../components/ArticleShell.astro";
import PageToc from "../../components/PageToc.astro";
import SiteLayout from "../../components/SiteLayout.astro";
import { docsNavigation as docsNav, docsHref as docsUrl, docsSlug } from "../../lib/docs";

export async function getStaticPaths() {
  const entries = (await getCollection("docs")).filter((entry) => docsSlug(entry));
  return entries.map((entry) => ({ params: { slug: docsSlug(entry) }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"docs">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const currentIndex = docsNav.findIndex((item) => item.slug === docsSlug(entry));
const previous = currentIndex > 0 ? docsNav[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < docsNav.length - 1 ? docsNav[currentIndex + 1] : undefined;
const rawUrl = entry.data.editUrl?.replace("/edit/", "/raw/");
---

<SiteLayout
  activeApp="dotfiles"
  title={entry.data.title}
  description={entry.data.description}
  searchType="Documentation"
  showProgress
>
  <ArticleShell
    title={entry.data.title}
    description={entry.data.description}
    previous={previous && { href: docsUrl(previous.slug), title: previous.label }}
    next={next && { href: docsUrl(next.slug), title: next.label }}
    adjacentLabel="Adjacent documentation"
  >
    {entry.data.editUrl && (
      <p slot="actions" class="page-source-actions">
        {rawUrl && <a href={rawUrl} aria-label="View source of this page" title="View source">View source</a>}
        <a href={entry.data.editUrl} aria-label="Edit this page" title="Edit this page">Edit this page</a>
      </p>
    )}
    <PageToc slot="toc" headings={headings} />
    <Content />
  </ArticleShell>
</SiteLayout>
