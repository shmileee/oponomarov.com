{
  "name": "oponomarov.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-content.mjs",
    "dev": "astro dev --port 4321",
    "prebuild": "node scripts/sync-content.mjs",
    "build": "astro build --force && pagefind --site dist",
    "check": "astro check",
    "test": "node --test src/lib/*.test.mjs scripts/qa/*.test.mjs",
    "preview": "astro preview --port 4325",
    "verify": "node scripts/verify-build.mjs && node scripts/verify-design.mjs && node scripts/qa/code-width.mjs --strict",
    "qa:code": "node scripts/qa/code-width.mjs",
    "shots:iphone": "node scripts/qa/shots-iphone.mjs",
    "qa": "node scripts/qa/measure.mjs --out=.omo/qa/current && node scripts/qa/contract.mjs .omo/qa/current/raw.json",
    "qa:full": "node scripts/qa/measure.mjs --all-viewports --shots --out=.omo/qa/current && node scripts/qa/contract.mjs .omo/qa/current/raw.json",
    "qa:report": "node scripts/qa/report.mjs .omo/qa/current/raw.json",
    "generate-favicons": "node scripts/generate-favicons.mjs",
    "lint:css": "stylelint \"src/styles/**/*.css\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/rss": "4.0.19",
    "astro": "7.2.10",
    "astro-expressive-code": "0.44.2",
    "satori": "0.33.4",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.13.3",
    "js-yaml": "4.3.2",
    "pagefind": "1.5.2",
    "playwright": "^1.63.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
