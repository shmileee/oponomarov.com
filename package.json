{
  "name": "oponomarov-unified-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-content.mjs",
    "dev": "astro dev --port 4321",
    "prebuild": "node scripts/sync-content.mjs",
    "build": "astro build && pagefind --site dist",
    "check": "astro check",
    "preview": "astro preview --port 4325",
    "verify": "node scripts/verify-build.mjs",
    "generate-favicons": "node scripts/generate-favicons.mjs",
    "convert-origins": "node scripts/convert-origins.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/rss": "4.0.19",
    "astro": "7.2.10",
    "astro-expressive-code": "0.44.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "js-yaml": "4.1.0",
    "pagefind": "1.5.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
